# Indra's Pearls: necklaces of jewelled circles, each holding smaller
# necklaces, each holding smaller ones still, endlessly reflecting into
# one another, and the view sinking forever toward the point where they
# all converge.
#
# The picture is the limit set of a group generated by circle
# inversions, drawn per pixel in the composite shader. In a hidden plane
# w, two concentric circles (radii rho and 1) bound an annulus holding a
# ring of k pearls (a Steiner chain, shrunk a little so the pearls stand
# apart). Each pixel is folded back into the gaps of that annulus by
# repeated inversions (in the inner rim, the outer rim and the nearest
# pearl; at most 64), counting them: inversion in the rims steps between
# annuli, inversion in a pearl steps into its nested pearls. The count,
# the folded position and the stretch the inversions applied give the
# colour and a glowing rim of constant width on screen.
#
# The screen sees w through a Moebius map w = K (z - p) / (z - q), so the
# nesting is eccentric, like a Kleinian group's, rather than concentric,
# and p is a limit point. The w plane is scaled down by s^-t (s = 1 / rho,
# the factor between annuli, a symmetry of the picture) with t wrapping
# at 1, so the zoom toward p never ends and never jumps; the colours
# shift with t so they come round seamlessly too.
#
# Bass hastens the zoom (an accumulated phase) and brightens the rims;
# mids turn the necklaces; treble glitters along the rims. A kick (at
# most every eight seconds) eases, over about a second, into a new
# configuration: another number of pearls and another Moebius view.
version = 1

[meta]
name = "Indra's Pearls"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "rgba8"
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
ka = 6; kb = 6;
qa = 2.2; qb = 2.2;
wb = 1;
ht = 0;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.04;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb, 2.5) - st) * 0.1;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.12;
// The zoom, in natural-log units (accumulated, never time times the
// bass), and each configuration's own wrapped phase of it.
lz = lz + 0.0016 + 0.0022 * min(sb, 2) / 2;
// Turning (accumulated, wrapped).
ph = ph + 0.0007 + 0.0022 * min(sm, 2) / 2;
ph = ph - 6.2831853 * floor(ph / 6.2831853);
// A new configuration on a kick, at most every eight seconds, and at
// least every thirty.
ht = ht + 1;
if(wb >= 1 && ht > 480 && (be > 0.55 || ht > 1800),
  ka = kb; qa = qb;
  kb = 3 + rand(6);
  kb = if(kb == ka, 3 + (kb - 2) % 6, kb);
  qb = rand(1000) / 1000 * 6.2831853;
  wb = 0;
  ht = 0,
  0);
wb = min(1, wb + 1 / 70);
ws = wb * wb * (3 - 2 * wb);
// Each configuration's zoom factor between annuli, s = 1 / rho.
sa = sin(3.14159265 / ka);
ra = (1 - sa) / (1 + sa);
sn = sin(3.14159265 / kb);
rb = (1 - sn) / (1 + sn);
za = lz / -log(ra);
za = za - floor(za);
zb = lz / -log(rb);
zb = zb - floor(zb);
hu = hu + 0.0005;
hu = hu - floor(hu);
q1 = ka; q2 = kb; q3 = ws; q4 = ph;
q5 = za; q6 = zb; q7 = hu; q8 = sb;
q9 = cos(qa); q10 = sin(qa); q11 = cos(qb); q12 = sin(qb);
q13 = st; q14 = be; q15 = sm;
'''

[shader]
comp = '''
let tau = 6.2831853;
let asp = u.texsize.x * u.texsize.w;
let ws = u.q[0].z;
let phi = u.q[0].w;
let hu = u.q[1].z;
let sb = min(u.q[1].w, 2.0) * 0.5;
let st = max(0.0, min(u.q[3].x, 2.5) - 0.35);
let be = min(u.q[3].y, 1.0);
let px = 2.0 * u.texsize.w;
// Screen position, y up, [-1, 1] vertically.
let z = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y) * 2.0;
let p = vec2f(0.12, -0.04);
var acc = vec3f(0.0);
for (var cfg = 0; cfg < 2; cfg++) {
    let wt = select(1.0 - ws, ws, cfg == 1);
    if (wt < 0.002) {
        continue;
    }
    let k = select(u.q[0].x, u.q[0].y, cfg == 1);
    let zt = select(u.q[1].x, u.q[1].y, cfg == 1);
    let qdir = select(u.q[2].xy, u.q[2].zw, cfg == 1);
    let sk = sin(3.14159265 / k);
    let rho = (1.0 - sk) / (1.0 + sk);
    let rho2 = rho * rho;
    // The pearls are a little smaller than the chain's tangent circles, so
    // they and their nested images stand apart as distinct beads. Each is
    // centred where inversion in the circle of radius sqrt(rho) maps it to
    // itself (dmid^2 - rc^2 = rho), so the annuli stay exact scaled copies
    // and the zoom wraps without a seam.
    let rc = 0.41 * (1.0 - rho);
    let dmid = sqrt(rho + rc * rc);
    let seg = tau / k;
    // The Moebius view: p goes to 0, q to infinity.
    let q = p + qdir * 2.1;
    let a = z - p;
    let b = z - q;
    let bb = dot(b, b);
    let kk = 1.6;
    var w = kk * vec2f(a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y) / bb;
    // |dw/dz| = K |p - q| / |z - q|^2.
    let dwdz = kk * length(p - q) / bb;
    // Turn, then zoom toward the limit point (w = 0).
    let zf = exp(zt * log(rho));
    let cr = cos(phi);
    let sr = sin(phi);
    w = vec2f(cr * w.x - sr * w.y, sr * w.x + cr * w.y) * zf;
    var scl = dwdz * zf;
    // n: the signed number of rim inversions before the first pearl
    // inversion (which annulus); m: rim inversions after it, unsigned
    // (the symmetry that makes the zoom seamless swaps the two rims).
    var n = 0.0;
    var m = 0.0;
    var c = 0.0;
    var done = false;
    for (var i = 0; i < 64; i++) {
        let r2 = dot(w, w);
        if (r2 > 1.0) {
            w = w / r2;
            scl = scl / r2;
            if (c > 0.0) {
                m += 1.0;
            } else {
                n += 1.0;
            }
            continue;
        }
        if (r2 < rho2) {
            w = w * (rho2 / max(r2, 1e-12));
            scl = scl * rho2 / max(r2, 1e-12);
            if (c > 0.0) {
                m += 1.0;
            } else {
                n -= 1.0;
            }
            continue;
        }
        // The nearest pearl of the chain.
        let ang = atan2(w.y, w.x);
        let j = round(ang / seg);
        let cj = dmid * vec2f(cos(j * seg), sin(j * seg));
        let d = w - cj;
        let dd = dot(d, d);
        if (dd < rc * rc) {
            w = cj + d * (rc * rc / dd);
            scl = scl * rc * rc / dd;
            c += 1.0;
            continue;
        }
        done = true;
        break;
    }
    // Fold the inner half of the annulus onto the outer half (inversion in
    // the circle of radius sqrt(rho), a symmetry of the picture), so the
    // shading below is the same in every annulus and the zoom wraps
    // seamlessly.
    let rw0 = length(w);
    if (rw0 < sqrt(rho)) {
        let f = rho / max(rw0 * rw0, 1e-12);
        w = w * f;
        scl = scl * f;
    }
    // Distance to the nearest circle, in the folded plane and on screen.
    let rw = length(w);
    let ang = atan2(w.y, w.x);
    let j = round(ang / seg);
    let cj = dmid * vec2f(cos(j * seg), sin(j * seg));
    let dpearl = length(w - cj) - rc;
    let dwf = min(min(1.0 - rw, rw - rho), dpearl);
    let de = select(0.0, max(dwf, 0.0) / max(scl, 1e-12), done);
    // Where in its gap the point lies: 0 at the rims, 1 at the middle.
    let mid = clamp(dwf / (0.3 * rc), 0.0, 1.0);
    // Jewel colours: the annulus (shifted with the zoom so it wraps
    // seamlessly), the depth of nesting and the side of the gap.
    let h = hu + 0.07 * (n + zt) + 0.19 * c + 0.11 * m + 0.05 * select(0.0, 1.0, dpearl < min(1.0 - rw, rw - rho));
    var gem = 0.5 + 0.5 * cos(tau * (vec3f(h) + vec3f(0.0, 0.33, 0.67)));
    gem = pow(gem, vec3f(1.6));
    gem = gem / max(max(gem.r, gem.g), max(gem.b, 0.05));
    // The gaps stay dark (a deep jewel tint, a faint pearly sheen toward
    // the middle), so the rims and pearls glow out of them.
    var col = gem * (0.06 + 0.05 * mid) + vec3f(0.012) * mid * mid;
    // Glowing rims, of constant width on screen.
    let rim = exp(-de / (px * (1.0 + 0.6 * sb)));
    let halo = exp(-de / (px * 9.0));
    let rimc = mix(vec3f(1.0, 0.92, 0.75), gem, 0.35);
    // Treble glitters along the rims.
    let gl = textureSampleLevel(sampler_noisevol_hq, s_fw, vec3f(w * 3.0, u.time * 0.3), 0.0).x;
    let glit = smoothstep(0.7, 0.95, gl) * st * 1.5;
    col += rimc * (rim * (0.9 + 0.5 * sb + 0.4 * be + glit) + halo * (0.26 + 0.15 * be));
    // Unresolved points crowd the limit set: let them glow.
    // Where the pearls shrink to a few pixels, fade their detail to its
    // average, so the finest nesting shimmers softly instead of aliasing.
    let size = rc / max(scl, 1e-12);
    let aa = smoothstep(px * 2.0, px * 9.0, size);
    let avg = gem * 0.25 + mix(vec3f(1.0, 0.92, 0.75), gem, 0.35) * (0.3 + 0.1 * sb);
    col = mix(avg, col, aa);
    col = select(avg, col, done);
    acc += wt * col;
}
// A soft bloom toward the limit point.
acc += vec3f(0.2, 0.16, 0.26) * exp(-length(z - p) * 2.0) * (0.4 + 0.4 * be);
return acc / (1.0 + 0.25 * acc);
'''
