# Silk Attractor: a Clifford strange attractor spun into glowing silk.
# Thousands of points ride the map
#   x' = sin(a y) + c cos(a x),  y' = sin(b x) + d cos(b y)
# and every tick each lays down a soft, iridescent dot (coloured by where
# it lies on the attractor) into the feedback buffer, which fades them
# slowly, so the orbit builds a luminous cloud of folded ribbons. The
# parameters glide along a closed path through chaotic territory (chosen
# so the attractor never collapses into a few points), so the silk
# continuously refolds itself into new shapes.
#
# Four shapes of 320 instances each carry their own orbits (two steps
# of the map per instance per tick), and three custom waves draw finer
# threads of single dots (one step per point); the warp shader turns and
# zooms the trails along with the view so they stay sharp.
#
# Bass drives how fast the parameters travel along their path (an
# accumulated phase, never time times the bass). Mids turn and zoom the
# view. Treble scatters white sparkles through the threads. Each kick
# blooms the glow, eased in and out over half a second.
version = 1

[meta]
name = "Silk Attractor"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "fp16"
decay = 1.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [16, 12]
b1n = 0.0
b1x = 3.0
b2n = 0.0
b2x = 3.0
b3n = 0.0
b3x = 3.0

[code]
init = '''
zs = 0.3;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb, 2.5) - st) * 0.2;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.12;
// The parameter path (accumulated, wrapped): about two minutes a lap,
// faster with the bass.
ph = ph + 0.0005 + 0.0011 * min(sb, 2) / 2 + 0.0004 * min(be, 1);
ph = ph - 6.2831853 * floor(ph / 6.2831853);
pa = -1.846 + 0.141 * sin(3 * ph + 2.03);
pb = 1.933 + 0.101 * sin(ph + 3.491);
pc = 0.9 + 0.301 * sin(3 * ph + 3.848);
pd = 0.817 + 0.311 * sin(3 * ph + 0.341);
// The view: a slow turn, quicker with the mids, and a gentle zoom.
dv = 0.0012 + 0.0035 * min(sm, 2) / 2;
va = va + dv;
va = va - 6.2831853 * floor(va / 6.2831853);
ext = sqrt(sqr(1 + abs(pc)) + sqr(1 + abs(pd)));
zt = (0.68 + 0.1 * min(sm, 2) / 2) / ext;
zp = zs;
zs = zs + (zt - zs) * 0.05;
// Colour drift.
hu = hu + 0.0007;
hu = hu - floor(hu);
q1 = pa; q2 = pb; q3 = pc; q4 = pd;
q5 = cos(va); q6 = sin(va); q7 = zs; q8 = st;
q9 = be; q10 = hu; q11 = dv; q12 = zs / zp;
q13 = sb; q14 = sm;
'''

[[shape]]
enabled = true
sides = 6
instances = 320
additive = 1
border_a = 0.0
rad = 0.0075
init = '''
ox = 0.31; oy = -0.42;
'''
frame = '''
loop(2,
  px = ox; py = oy;
  ox = sin(q1 * py) + q3 * cos(q1 * px);
  oy = sin(q2 * px) + q4 * cos(q2 * py));
vx = (ox * q5 - oy * q6) * q7;
vy = (ox * q6 + oy * q5) * q7;
x = 0.5 + vx * aspecty;
y = 0.5 + vy;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
a = 0.08;
r2 = r; g2 = g; b2 = b; a2 = 0;
'''

[[shape]]
enabled = true
sides = 6
instances = 320
additive = 1
border_a = 0.0
rad = 0.0075
init = '''
ox = -0.7; oy = 0.15;
'''
frame = '''
loop(2,
  px = ox; py = oy;
  ox = sin(q1 * py) + q3 * cos(q1 * px);
  oy = sin(q2 * px) + q4 * cos(q2 * py));
vx = (ox * q5 - oy * q6) * q7;
vy = (ox * q6 + oy * q5) * q7;
x = 0.5 + vx * aspecty;
y = 0.5 + vy;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10 + 0.03;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
a = 0.08;
r2 = r; g2 = g; b2 = b; a2 = 0;
'''

[[shape]]
enabled = true
sides = 6
instances = 320
additive = 1
border_a = 0.0
rad = 0.0075
init = '''
ox = 0.05; oy = 0.9;
'''
frame = '''
loop(2,
  px = ox; py = oy;
  ox = sin(q1 * py) + q3 * cos(q1 * px);
  oy = sin(q2 * px) + q4 * cos(q2 * py));
vx = (ox * q5 - oy * q6) * q7;
vy = (ox * q6 + oy * q5) * q7;
x = 0.5 + vx * aspecty;
y = 0.5 + vy;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10 + 0.06;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
a = 0.08;
r2 = r; g2 = g; b2 = b; a2 = 0;
'''

[[shape]]
enabled = true
sides = 6
instances = 320
additive = 1
border_a = 0.0
rad = 0.0075
init = '''
ox = -0.2; oy = -1.1;
'''
frame = '''
loop(2,
  px = ox; py = oy;
  ox = sin(q1 * py) + q3 * cos(q1 * px);
  oy = sin(q2 * px) + q4 * cos(q2 * py));
vx = (ox * q5 - oy * q6) * q7;
vy = (ox * q6 + oy * q5) * q7;
x = 0.5 + vx * aspecty;
y = 0.5 + vy;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10 + 0.09;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
a = 0.08;
r2 = r; g2 = g; b2 = b; a2 = 0;
'''

# Fine threads: single dots, one step of the map per point.
[[wave]]
enabled = true
samples = 512
usedots = 1
additive = 1
init = '''
ox = 0.4; oy = 0.2;
'''
frame = '''
a = 0.12;
'''
point = '''
px = ox; py = oy;
ox = sin(q1 * py) + q3 * cos(q1 * px);
oy = sin(q2 * px) + q4 * cos(q2 * py);
x = 0.5 + (ox * q5 - oy * q6) * q7 * aspecty;
y = 0.5 + (ox * q6 + oy * q5) * q7;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10 + 0.12;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
'''

[[wave]]
enabled = true
samples = 512
usedots = 1
additive = 1
init = '''
ox = -0.3; oy = 0.6;
'''
frame = '''
a = 0.12;
'''
point = '''
px = ox; py = oy;
ox = sin(q1 * py) + q3 * cos(q1 * px);
oy = sin(q2 * px) + q4 * cos(q2 * py);
x = 0.5 + (ox * q5 - oy * q6) * q7 * aspecty;
y = 0.5 + (ox * q6 + oy * q5) * q7;
hh = 0.22 * ox + 0.16 * oy + 0.06 * atan2(oy - py, ox - px) + q10 + 0.15;
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
'''

# Sparkles: white glints that come out with the treble.
[[wave]]
enabled = true
samples = 512
usedots = 1
thick = 1
additive = 1
init = '''
ox = 0.9; oy = -0.5;
'''
frame = '''
a = 0.05 + 0.5 * max(0, min(q8, 2.5) - 0.4) / 2;
'''
point = '''
px = ox; py = oy;
ox = sin(q1 * py) + q3 * cos(q1 * px);
oy = sin(q2 * px) + q4 * cos(q2 * py);
x = 0.5 + (ox * q5 - oy * q6) * q7 * aspecty;
y = 0.5 + (ox * q6 + oy * q5) * q7;
r = 1; g = 0.95; b = 0.9;
'''

[shader]
warp = '''
// Turn and zoom the trails with the view, then fade them.
let asp = u.texsize.x * u.texsize.w;
let p = (uv_orig - vec2f(0.5)) * vec2f(asp, 1.0);
let da = u.q[2].z;
let zr = max(u.q[2].w, 0.5);
let c = cos(da);
let s = sin(da);
// Screen y is down, the view's y is up: undo a counter-clockwise turn.
let q = vec2f(c * p.x - s * p.y, s * p.x + c * p.y) / zr;
let src = q / vec2f(asp, 1.0) + vec2f(0.5);
return textureSampleLevel(sampler_main, s_fc, src, 0.0).rgb * 0.968;
'''
comp = '''
let tau = 6.2831853;
let asp = u.texsize.x * u.texsize.w;
let be = min(u.q[2].x, 1.0);
let hu = u.q[2].y;
let sb = min(u.q[3].x, 2.0) * 0.5;
let p = (uv - vec2f(0.5)) * vec2f(asp, 1.0);
let c = textureSampleLevel(sampler_main, s_fc, uv, 0.0).rgb;
let b2 = GetBlur2(uv);
let b3 = GetBlur3(uv);
// The silk: exposure that keeps the colour of thin threads and rolls
// the dense folds toward white.
let silk = vec3f(1.0) - exp(-c * 1.1);
// A luminous, iridescent backdrop that the glow of the cloud tints.
let bh = hu + 0.4 * length(p) + 0.18 * p.x + 0.12 * p.y;
let bg = 0.5 + 0.5 * cos(tau * (vec3f(bh + 0.55) + vec3f(0.0, 0.33, 0.67)));
// (Normalised to a steady luminance whatever the hue.)
let bq = bg * bg + vec3f(0.04);
var col = bq / dot(bq, vec3f(0.2126, 0.7152, 0.0722)) * (0.25 + 0.04 * sb) + vec3f(0.05, 0.04, 0.1);
col *= 1.0 - 0.35 * smoothstep(0.3, 1.0, length(p));
col += (1.0 - exp(-b3 * 1.5)) * 0.22;
col += (1.0 - exp(-b2 * 1.2)) * (0.16 + 0.45 * be);
col = col * (1.0 - 0.6 * silk) + silk * 1.3;
let lc = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lc) + (col - vec3f(lc)) * 1.35, vec3f(0.0));
return col / (1.0 + 0.3 * col);
'''
