# Neon Orbit: a swarm of neon comets circling a blazing core in deep
# space. Thirty-six comets (cyan, magenta, lime, gold and violet) ride
# their own tilted orbits, the inner ones faster, each trailing a long
# fading streak of its colour, so the swarm is wrapped in crossing arcs
# of light. Round the core spins a tilted accretion disc, white-hot at
# its inner edge, cooling through magenta to violet, streaked with
# spiralling gas and brighter on the side that turns toward you; faint
# stars lie far behind.
#
# The comets are one shape with six instances per comet: each comet's
# orbit (radius, tilt, node, phase) comes from hashes of its number, and
# the six instances draw it where it is now (the head, a little
# bigger) and at five even steps back over the last tick,
# so its trail is unbroken however fast it goes. The
# orbit is turned into the view (looking down on the disc from 26
# degrees) with a little perspective, nearer comets bigger and brighter.
# They are drawn into an fp16 feedback buffer which only fades (the
# custom warp), so each comet leaves its streak. The composite draws the
# disc (the inverse of the same view, with noise streaks wound into
# spirals and Doppler brightening), the core and its glow, the stars,
# and the trails with a bloom from the blur levels.
#
# The frame code accumulates the orbital phase and the disc's spin. Each
# hit of the music is felt at once, through pulses of the bass, mids and
# treble that rise in a tick or two and die away over a fraction of a
# second (soft-limited): a kick flings every comet outward (each by its
# own amount, then they fall back, drawing spirals with their trails),
# swells their heads and makes the core flare and the disc burn
# brighter; the mids speed the orbits and the disc; the treble makes the
# comet heads sparkle and the stars twinkle.
version = 1

[meta]
name = "Neon Orbit"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "fp16"
decay = 1.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
frame = '''
// The per-hit pulses: fast attack, slower decay, soft-limited.
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
// The fling: out with the kick, falling back more slowly.
ofl = fl;
fl = fl + (pb - fl) * if(pb > fl, 0.5, 0.05);
// Orbital phase and the disc's spin, faster with the mids.
dp = (0.9 + 1.6 * pm + 0.6 * pb) / 60;
ph = ph + dp;
ph = ph - 6283.1853 * floor(ph / 6283.1853);
ds = ds + (0.5 + 1.5 * pm) / 60;
ds = ds - 6.2831853 * floor(ds / 6.2831853);
q1 = ds; q2 = pb; q3 = pm; q4 = pt;
q5 = fl; q6 = ph; q7 = dp; q8 = ofl;
'''

[[shape]]
enabled = true
sides = 12
instances = 216
rad = 0.008
r = 1.0
g = 1.0
b = 1.0
a = 1.0
r2 = 1.0
g2 = 1.0
b2 = 1.0
a2 = 0.0
additive = 1
frame = '''
ci = floor(instance / 6); k = instance - ci * 6;
h1 = sin(ci * 12.9898 + 1.7) * 43758.5453; h1 = h1 - floor(h1);
h2 = sin(ci * 78.233 + 4.1) * 23421.631; h2 = h2 - floor(h2);
h3 = sin(ci * 39.425 + 2.9) * 51729.117; h3 = h3 - floor(h3);
h4 = sin(ci * 91.771 + 0.3) * 31337.713; h4 = h4 - floor(h4);
// The orbit: radius, Kepler rate, tilt, node.
rr = 0.2 + 0.42 * h1;
w = 1.15 * pow(0.3 / rr, 1.5);
th = (q6 - k * q7 / 6) * w * if(h4 > 0.15, 1, -1) + ci * 2.3999632;
inc = (h2 - 0.5) * 1.3;
nd = h3 * 6.2831853;
rf = rr * (1 + (q5 - k * (q5 - q8) / 6) * (0.35 + 0.9 * h4));
// In the orbit's plane, tilted about its node line.
ox = rf * cos(th); oy = rf * sin(th) * cos(inc); oz = rf * sin(th) * sin(inc);
u1 = ox * cos(nd) - oy * sin(nd); v1 = ox * sin(nd) + oy * cos(nd);
// Into the view: the disc's plane seen from 26 degrees above.
vy = v1 * 0.4384 + oz * 0.8988;
dz = v1 * 0.8988 - oz * 0.4384;
s = 1 / (1 + 0.6 * dz);
x = 0.5 + u1 * s * aspecty;
y = 0.5 + vy * s;
// Colour: cyan, magenta, lime, gold, violet.
cc = ci - 5 * floor(ci / 5);
r2 = if(cc < 0.5, 0.1, if(cc < 1.5, 1.0, if(cc < 2.5, 0.5, if(cc < 3.5, 1.0, 0.6))));
g2 = if(cc < 0.5, 0.85, if(cc < 1.5, 0.12, if(cc < 2.5, 1.0, if(cc < 3.5, 0.7, 0.25))));
b2 = if(cc < 0.5, 1.0, if(cc < 1.5, 0.75, if(cc < 2.5, 0.15, if(cc < 3.5, 0.1, 1.0))));
r = 0.55 + 0.45 * r2; g = 0.55 + 0.45 * g2; b = 0.55 + 0.45 * b2;
sp = sin(q6 * 37 + ci * 5.1);
a = (0.17 + 0.2 * s) * (0.75 + 0.6 * q4 * sp * sp) * if(k < 0.5, 1.3, 1);
rad = (0.0055 + 0.0025 * h4) * s * (1 + 0.5 * q2) * if(k < 0.5, 1.1, 1);
'''

[shader]
warp = '''
// Only fade: each comet leaves its streak.
return textureSampleLevel(sampler_main, s_pc, uv_orig, 0.0).rgb * 0.962;
'''
comp = '''
let asp = u.texsize.x * u.texsize.w;
let ds = u.q[0].x;
let pb = u.q[0].y;
let pm = u.q[0].z;
let pt = u.q[0].w;
let X = (uv.x - 0.5) * asp;
let Y = 0.5 - uv.y;
let lw = max(1.0, u.texsize.y / 540.0);
// Stars.
var col = vec3f(0.002, 0.002, 0.008);
let cell = floor(uv * u.texsize.xy / lw);
let h0 = (u32(cell.x) * 1973u + u32(cell.y) * 9277u) * 747796405u + 2891336453u;
let h1 = ((h0 >> ((h0 >> 28u) + 4u)) ^ h0) * 277803737u;
let hh = f32((h1 >> 22u) ^ h1) / 4294967296.0;
let tw = 0.7 + 0.3 * sin(u.time * (1.0 + 3.0 * hh) + hh * 40.0) + 0.8 * pt * fract(hh * 517.0);
col += vec3f(0.7, 0.8, 1.0) * step(0.9975, hh) * (0.2 + 0.5 * fract(hh * 911.0)) * tw;
// A faint violet nebula haze.
let nz = textureSampleLevel(sampler_noise_lq, s_fw, uv * vec2f(asp, 1.0) * 0.35 + vec2f(0.3, 0.1), 0.0).r;
col += vec3f(0.07, 0.02, 0.1) * nz * nz;
// The accretion disc: the inverse of the comets' view.
let se = 0.4384;
let ce = 0.8988;
let dv = Y / (se - 0.6 * Y * ce);
let du = X * (1.0 + 0.6 * dv * ce);
let rho = length(vec2f(du, dv));
let phi = atan2(dv, du);
let rin = 0.055;
let rout = 0.3 + 0.04 * pb;
let band = smoothstep(rin, rin + 0.015, rho) * (1.0 - smoothstep(rout - 0.06, rout, rho));
let lr = log(max(rho, 1e-3));
let sw = textureSampleLevel(sampler_noise_lq, s_fw, vec2f((phi + ds * 1.0 - lr * 2.2) * 0.477, lr * 0.9 + ds * 0.05), 0.0).r;
let sw2 = textureSampleLevel(sampler_noise_lq, s_fw, vec2f((phi + ds * 1.6 - lr * 3.5) * 0.955, lr * 1.7), 0.0).r;
let tt = clamp((rho - rin) / (rout - rin), 0.0, 1.0);
let dcol = mix(mix(vec3f(1.0, 0.95, 1.0), vec3f(1.0, 0.25, 0.8), smoothstep(0.0, 0.35, tt)), vec3f(0.4, 0.15, 1.0), smoothstep(0.35, 1.0, tt));
let dop = 1.0 + 0.55 * cos(phi - 0.3);
let dval = band * (0.35 + 0.9 * sw * sw2 + 0.25 * sw) * dop * (1.0 - 0.6 * tt) * (0.9 + 0.45 * pb);
col += dcol * dval * 1.4;
// The core and its glow; a kick makes it flare.
let r = length(vec2f(X, Y));
col += vec3f(1.0, 0.95, 1.0) * smoothstep(0.03, 0.018, r) * 1.2;
col += vec3f(0.6, 0.55, 1.0) * (0.04 / (r + 0.025)) * (0.3 + 0.35 * pb);
let spk = exp(-abs(X) * 220.0 / lw) * exp(-abs(Y) * 9.0) + exp(-abs(Y) * 220.0 / lw) * exp(-abs(X) * 9.0);
col += vec3f(0.8, 0.85, 1.0) * spk * pb * 0.5;
// The comets and their trails, with a bloom.
let c = GetMain(uv);
let bl = GetBlur1(uv) * 0.5 + GetBlur2(uv) * 0.6;
col += c * 1.2 + bl * (0.5 + 0.2 * pb);
return col / (1.0 + 0.35 * col);
'''
