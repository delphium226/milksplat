# Slime Mold: a Physarum plasmodium spread across a dark dish, seen
# from above, a living net of glowing yellow-green tubes linking five
# food sources, golden blobs where it feeds. The main veins are fat and
# rounded, thickening toward the food, and between them a finer cyan
# mesh of thinner veins fills the gaps; where veins meet, the junctions
# swell into bright nodes. Peristaltic waves of flow pulse out from the
# food along every tube, and the whole network slowly shifts, its
# meshes opening and closing as it searches.
#
# Everything is in the composite. The veins are the borders of two
# Voronoi networks, a coarse and a fine one, on a plane gently warped by
# noise so they curve like living tubes; their sites drift slowly round
# their cells, so the net reshapes itself. A pixel finds its nearest
# site and then its distance to the borders round it (and the second
# nearest border, so junctions, where two borders meet, can glow). Each
# vein is a rounded tube of a width that varies along it, wider near
# the food. The flow is a wave in the distance from the nearest food.
#
# The frame code accumulates the flow and the net's drift and runs the
# kicks' pulses and tendrils. Bass brightens the network (smoothed).
# Each hit of the music is felt at once, through pulses of the bass,
# mids and treble that rise in a tick or two and die away over a
# fraction of a second (soft-limited, so a bigger hit still means more):
# a kick sends a peristaltic pulse out from every food source, the tubes
# bulging and flaring as it passes (up to three at once), and grows a
# burst of new tendrils, the fine mesh thickening and lighting up round
# the next food in turn; the mids speed the flow (accumulated); the
# treble glints the nodes.
version = 1

[meta]
name = "Slime Mold"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
fl = 0; mo = 0; ti = 0;
// A tendril burst already growing, so the screen is never bare.
f1 = 1; g1 = 0.2; e1 = 1;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
st = st + (min(treb_att, 2.5) - st) * 0.1;
// The per-hit pulses: fast attack, slower decay, soft-limited.
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
ob = pb;
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
// The flow (accumulated), quicker with the mids, and the net's drift.
fl = fl + (0.04 + 0.2 * pm);
fl = fl - 6.2831853 * 64 * floor(fl / (6.2831853 * 64));
mo = mo + 0.0025;
mo = mo - 6.2831853 * 64 * floor(mo / (6.2831853 * 64));
// A fresh kick sends a pulse out from the food (three slots) and grows
// tendrils round the next food in turn (three slots).
kk = max(pb - ob, 0);
cd = cd + 1;
if(kk > 0.12 && cd > 8,
  cd = 0; sl = (sl + 1) % 3; ti = (ti + 1) % 5;
  if(sl == 0, r1 = 0; a1 = min(pb, 1.5); f1 = ti; g1 = 0; e1 = min(0.5 + pb, 1.5), 0);
  if(sl == 1, r2 = 0; a2 = min(pb, 1.5); f2 = ti; g2 = 0; e2 = min(0.5 + pb, 1.5), 0);
  if(sl == 2, r3 = 0; a3 = min(pb, 1.5); f3 = ti; g3 = 0; e3 = min(0.5 + pb, 1.5), 0),
  0);
r1 = min(r1 + 0.012, 2); r2 = min(r2 + 0.012, 2); r3 = min(r3 + 0.012, 2);
a1 = a1 * 0.97; a2 = a2 * 0.97; a3 = a3 * 0.97;
g1 = min(g1 + 0.006, 0.5); g2 = min(g2 + 0.006, 0.5); g3 = min(g3 + 0.006, 0.5);
e1 = e1 * 0.993; e2 = e2 * 0.993; e3 = e3 * 0.993;
q1 = r1; q2 = a1; q3 = r2; q4 = a2;
q5 = r3; q6 = a3; q7 = fl; q8 = mo;
q9 = f1; q10 = g1; q11 = e1; q12 = 0;
q13 = f2; q14 = g2; q15 = e2; q16 = 0;
q17 = f3; q18 = g3; q19 = e3; q20 = 0;
q21 = pb; q22 = pm; q23 = pt; q24 = sb;
q25 = st;
'''

[shader]
comp = '''
let sz = u.texsize.xy;
let asp = sz.x / sz.y;
let fl = u.q[1].z;
let mo = u.q[1].w;
let pb = u.q[5].x;
let be = min(pb, 1.5);
let pt = min(u.q[5].z, 1.5);
let sb = min(u.q[5].w, 2.0) * 0.5;
let st = max(0.0, min(u.q[6].x, 2.5) - 0.3);
let px = 1.0 / sz.y;
let lw = max(1.0, sz.y / 540.0);
let p = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y);
// The food: five sources, drifting a little.
var food: array<vec2f, 5>;
food[0] = vec2f(-0.62, 0.22) + 0.02 * vec2f(sin(u.time * 0.11), cos(u.time * 0.13));
food[1] = vec2f(-0.15, -0.28) + 0.02 * vec2f(sin(u.time * 0.09 + 1.0), cos(u.time * 0.12 + 2.0));
food[2] = vec2f(0.28, 0.25) + 0.02 * vec2f(sin(u.time * 0.1 + 3.0), cos(u.time * 0.08 + 1.0));
food[3] = vec2f(0.68, -0.18) + 0.02 * vec2f(sin(u.time * 0.12 + 5.0), cos(u.time * 0.1 + 4.0));
food[4] = vec2f(-0.05, 0.08) + 0.02 * vec2f(sin(u.time * 0.07 + 2.0), cos(u.time * 0.09 + 6.0));
var dfood = 9.0;
for (var i = 0; i < 5; i++) {
    dfood = min(dfood, length(p - food[i]));
}
// The kicks' pulses, running out from the food.
var kb = 0.0;
for (var j = 0; j < 3; j++) {
    let rr = u.q[j / 2][(j % 2) * 2];
    let ra = u.q[j / 2][(j % 2) * 2 + 1];
    let x = (dfood - rr) / 0.04;
    kb += ra * exp(-x * x);
}
// The tendrils growing round a food.
var tg = 0.0;
for (var j = 0; j < 3; j++) {
    let tq = u.q[2 + j];
    let fi = i32(tq.x + 0.5);
    let fp = select(select(select(select(food[4], food[3], fi == 3), food[2], fi == 2), food[1], fi == 1), food[0], fi == 0);
    tg += tq.z * smoothstep(tq.y, tq.y - 0.12, length(p - fp));
}
tg = min(tg, 1.5);
// The plane, gently warped, so the veins curve like living tubes.
let nw = textureSampleLevel(sampler_noise_mq, s_fw, p * 0.22 + vec2f(mo * 0.01, 0.0), 0.0).rg - vec2f(0.5);
let w = p + nw * 0.12;
var col = vec3f(0.006, 0.018, 0.016) + vec3f(0.01, 0.03, 0.02) * exp(-dot(p, p));
var ed = array<f32, 2>(1.0, 1.0);
var ej = array<f32, 2>(1.0, 1.0);
var eh = array<f32, 2>(0.0, 0.0);
for (var s = 0; s < 2; s++) {
    let scl = select(4.0, 8.5, s == 1);
    let x = w * scl + select(vec2f(0.0), vec2f(17.3, 5.1), s == 1);
    let n = floor(x);
    let f = x - n;
    // The nearest site (sites wander round their cells).
    var md = 8.0;
    var mr = vec2f(0.0);
    var mg = vec2f(0.0);
    for (var gy = -1; gy <= 1; gy++) {
        for (var gx = -1; gx <= 1; gx++) {
            let g = vec2f(f32(gx), f32(gy));
            let hh = fract(sin(vec2f(dot(n + g, vec2f(127.1, 311.7)), dot(n + g, vec2f(269.5, 183.3)))) * 43758.5453);
            let o = vec2f(0.5) + 0.38 * sin(vec2f(mo) * (0.6 + 0.4 * hh) + 6.2831853 * hh);
            let r = g + o - f;
            let d = dot(r, r);
            if (d < md) {
                md = d;
                mr = r;
                mg = g;
            }
        }
    }
    // The distance to the borders round it, and to the second nearest.
    var b1 = 8.0;
    var b2 = 8.0;
    var bh = 0.0;
    for (var gy = -2; gy <= 2; gy++) {
        for (var gx = -2; gx <= 2; gx++) {
            let g = mg + vec2f(f32(gx), f32(gy));
            let hh = fract(sin(vec2f(dot(n + g, vec2f(127.1, 311.7)), dot(n + g, vec2f(269.5, 183.3)))) * 43758.5453);
            let o = vec2f(0.5) + 0.38 * sin(vec2f(mo) * (0.6 + 0.4 * hh) + 6.2831853 * hh);
            let r = g + o - f;
            let dr = r - mr;
            if (dot(dr, dr) > 1e-5) {
                let bd = dot(0.5 * (mr + r), normalize(dr));
                if (bd < b1) {
                    b2 = b1;
                    b1 = bd;
                    bh = hh.x + hh.y;
                } else if (bd < b2) {
                    b2 = bd;
                }
            }
        }
    }
    ed[s] = b1 / scl;
    ej[s] = b2 / scl;
    eh[s] = bh;
}
// The veins: rounded tubes, varying in width along their length, wider
// near the food, bulging as a kick's pulse passes.
let nv = textureSampleLevel(sampler_noise_mq, s_fw, w * 0.7 + vec2f(3.1, mo * 0.02), 0.0).r;
let near = exp(-dfood * dfood / 0.05);
let swell = 1.0 + 0.8 * kb;
let t0 = (0.011 + 0.006 * nv + 0.016 * near) * swell + 0.6 * px;
let t1 = (0.0025 + 0.003 * nv) * (0.6 + 0.9 * tg) * swell + 0.5 * px;
let flow = 0.6 + 0.4 * sin(dfood * 28.0 - fl);
let v0 = clamp(1.0 - ed[0] / t0, 0.0, 1.0);
let v1 = clamp(1.0 - ed[1] / t1, 0.0, 1.0);
let tube0 = sqrt(v0) * smoothstep(0.0, min(1.5 * px / t0, 1.0), v0);
let tube1 = sqrt(v1) * smoothstep(0.0, min(1.5 * px / t1, 1.0), v1);
let vc0 = mix(vec3f(0.1, 0.8, 0.45), vec3f(0.85, 1.0, 0.25), 0.4 + 0.6 * near) ;
let vc1 = vec3f(0.1, 0.85, 1.0);
let fv = clamp(0.25 + tg, 0.0, 1.0);
// The thin slime sheet round the veins.
col += vec3f(0.12, 0.3, 0.12) * exp(-ed[0] / 0.03) * 0.25 * (0.8 + 0.4 * sb);
col += vc1 * exp(-ed[1] / 0.012) * 0.06 * fv;
col = mix(col, vc1 * (0.55 + 0.6 * tube1) * (0.75 + 0.25 * flow) * (1.0 + 0.8 * tg + 1.0 * kb), tube1 * fv);
col += vc0 * exp(-ed[0] / (t0 * 2.0)) * 0.13 * (1.0 + kb);
col = mix(col, vc0 * (0.5 + 0.7 * tube0) * flow * (0.85 + 0.3 * sb + 1.2 * kb), tube0);
// Junctions, where two borders meet: bright nodes, glinting with the
// treble.
let jn = exp(-pow(ej[0] / (t0 * 0.9), 2.0)) * smoothstep(1.0, 0.3, ed[0] / t0);
let cell = floor(uv * sz / (3.0 * lw));
let tq = floor(u.time * 12.0);
let hs = fract(sin(dot(cell + vec2f(tq * 2.3, tq * 4.1), vec2f(12.9898, 78.233))) * 43758.5453);
let glint = step(1.0 - 0.12 * (0.3 * min(st, 1.0) + pt), hs) * smoothstep(100.0, 300.0, sz.y);
col += vec3f(1.0, 1.0, 0.6) * jn * (0.45 + 0.3 * kb + glint * (0.6 + 1.2 * pt));
// The food: golden blobs with ragged edges.
for (var i = 0; i < 5; i++) {
    let d = p - food[i];
    let an = atan2(d.y, d.x);
    let rg = 0.045 * (1.0 + 0.4 * (textureSampleLevel(sampler_noise_mq, s_fw, vec2f(cos(an), sin(an)) * 0.06 + vec2f(f32(i) * 0.37, mo * 0.004), 0.0).r - 0.5) * 2.0) * (1.0 + 0.15 * be);
    let dl = length(d);
    let blob = smoothstep(rg, rg - 2.0 * px, dl);
    col = mix(col, vec3f(1.0, 0.85, 0.3) * (0.8 + 0.5 * (1.0 - dl / rg)) * (1.0 + 0.4 * be), blob);
    col += vec3f(1.0, 0.75, 0.2) * exp(-dl / 0.06) * 0.12 * (1.0 + be);
}
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.2, vec3f(0.0));
return col / (1.0 + 0.35 * col);
'''
