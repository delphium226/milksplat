# Supernova Remnant: the slowly expanding wreck of a star, in the style
# of the Crab and the Veil. A shell of tangled glowing filaments, hydrogen
# red on the outside, oxygen teal just within, sulphur gold through the
# body, around a faint pulsing pulsar wind nebula at the heart. The shell
# swells slowly, and as it thins and fades a new remnant fades in behind
# it. There is no explosion and no flash: the remnants come and go in
# slow fades, and the music only stirs the shell.
#
# Everything is in the composite. A remnant is a thick spherical shell
# seen in projection, so it is limb-brightened: its glow follows the
# path length of a sight line through the shell, 2 (sqrt(1 - r^2) -
# sqrt(0.82^2 - r^2)) in units of its radius, with the radius itself
# distorted by noise so the rim is ragged. The filaments are ridged 3D
# value noise (two octaves of the 64^3 noise volume, a different channel
# for each element, the domain warped by a third sample), sharpened to
# thin strands and weighted by the shell: red at the rim, teal a little
# further in, gold filling the body. The noise drifts slowly through its
# third axis, so the filaments seethe. At the centre a soft blue-white
# synchrotron glow with wisps pulses gently with the pulsar's spin.
#
# The frame code runs one clock (accumulated, a little faster with the
# bass) that wraps every 50 s. Each remnant lives 75 s: it fades in over
# 12 s, grows as t^0.6 (a blast wave slowing in the interstellar gas), and
# fades out over its last 20 s while the next, with a new seed and
# orientation, fades in. Two remnants are drawn at once.
#
# Bass brightens the filaments (smoothed). Mids quicken the seething.
# Treble twinkles the stars. Each hit of the music is felt at once,
# through pulses of the bass, mids and treble that rise in a tick or two
# and die away over a fraction of a second (soft-limited, so a bigger hit
# still means more): a kick sends a shock running out through the shell
# from the heart to the rim, lighting the filaments as it passes (up to
# two at once), and swells the wind nebula; the mids stir the filaments
# into a quick seethe; the treble twinkles the stars.
version = 1

[meta]
name = "Supernova Remnant"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
c = 22; nn = 3; zt = 0; pp = 0;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb_att, 2.5) - st) * 0.1;
// The per-hit pulses: fast attack, slower decay, soft-limited.
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
ob = pb;
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
// A fresh kick starts a shock at the heart, in the next of two slots;
// each runs out through the shell in under a second, fading.
kk = max(pb - ob, 0);
cdn = cdn + 1;
if(kk > 0.12 && cdn > 8,
  cdn = 0; sl = 1 - sl;
  if(sl == 0, w1 = 0.1; h1 = pb, w2 = 0.1; h2 = pb),
  0);
w1 = min(w1 + 0.022, 1.5); w2 = min(w2 + 0.022, 1.5);
h1 = h1 * 0.96; h2 = h2 * 0.96;
// The clock: a new remnant every 50 s.
c = c + (1 + 0.25 * min(sb, 2) / 2) / 60;
nn = nn + (c >= 50);
c = c - 50 * (c >= 50);
// The seething (accumulated, wrapped far from where it matters) and the
// pulsar's spin, about 1.3 turns a second.
zt = zt + 0.0006 + 0.0006 * min(sm, 2) / 2 + 0.001 * pm;
zt = zt - 64 * floor(zt / 64);
pp = pp + 6.2831853 * 1.3 / 60;
pp = pp - 6.2831853 * floor(pp / 6.2831853);
// The new remnant (age c) and the old one (age c + 50).
a = c; u1 = min(1, max(0, a / 12)); v1 = min(1, max(0, (a - 55) / 20));
q1 = 0.1 + 0.42 * pow(a / 60, 0.6);
q3 = u1 * u1 * (3 - 2 * u1) * (1 - v1 * v1 * (3 - 2 * v1));
a = c + 50; u1 = min(1, max(0, a / 12)); v1 = min(1, max(0, (a - 55) / 20));
q2 = 0.1 + 0.42 * pow(a / 60, 0.6);
q4 = u1 * u1 * (3 - 2 * u1) * (1 - v1 * v1 * (3 - 2 * v1));
q5 = nn; q6 = nn - 1; q7 = zt; q8 = pp;
q9 = sb; q10 = st; q11 = pb;
q12 = pt; q13 = w1; q14 = h1; q15 = w2; q16 = h2;
'''

[shader]
comp = '''
let asp = u.texsize.x * u.texsize.w;
let p = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y);
let sb = min(u.q[2].x, 2.0) * 0.5;
let st = max(0.0, min(u.q[2].y, 2.5) - 0.3);
let pb = u.q[2].z;
let pt = u.q[2].w;
let sk = u.q[3];
let zt = u.q[1].z;
let pulse = 0.5 + 0.5 * sin(u.q[1].w);
let lw = max(1.0, u.texsize.y / 540.0);
// Deep space: a faint dusty haze and stars.
let dn = textureSampleLevel(sampler_noisevol_lq, s_fw, vec3f(p * 0.7, 0.3), 0.0).r;
var col = vec3f(0.004, 0.004, 0.012) + vec3f(0.035, 0.02, 0.05) * dn;
let cell = floor(uv * u.texsize.xy / lw);
let h0 = (u32(cell.x) * 1973u + u32(cell.y) * 9277u) * 747796405u + 2891336453u;
let h1 = ((h0 >> ((h0 >> 28u) + 4u)) ^ h0) * 277803737u;
let hh = f32((h1 >> 22u) ^ h1) / 4294967296.0;
let tw = 0.5 + 0.5 * sin(u.time * (1.0 + 3.0 * hh) + hh * 40.0);
col += vec3f(0.75, 0.82, 1.0) * step(0.996, hh) * (0.3 + 0.5 * tw * (st + 0.6 * pt));
let cr = vec3f(1.0, 0.12, 0.22);
let ct = vec3f(0.1, 0.85, 0.8);
let cg = vec3f(1.0, 0.7, 0.18);
for (var i = 0; i < 2; i++) {
    let R = select(u.q[0].y, u.q[0].x, i == 0);
    let w = select(u.q[0].w, u.q[0].z, i == 0);
    let sd = select(u.q[1].y, u.q[1].x, i == 0);
    if (w > 0.002) {
        // This remnant's seed: an offset into the noise and a turn.
        let o = fract(vec3f(sd * 0.1031, sd * 0.1137, sd * 0.0973) * vec3f(97.1, 57.3, 31.7)) * 8.0;
        let th = sd * 2.39996;
        let cs = cos(th);
        let sn = sin(th);
        let x = vec2f(cs * p.x - sn * p.y, sn * p.x + cs * p.y) / R;
        let r = length(x);
        if (r < 1.35) {
            let wv = textureSampleLevel(sampler_noisevol_hq, s_fw, vec3f(x * 0.05 + o.xy, o.z + zt * 0.7), 0.0).rgb - vec3f(0.5);
            let y = x + wv.xy * 0.42;
            let rr = length(y) * (1.0 + 0.12 * wv.z);
            let n1 = textureSampleLevel(sampler_noisevol_hq, s_fw, vec3f(y * 0.1 + o.yz, o.x + zt), 0.0);
            let n2 = textureSampleLevel(sampler_noisevol_hq, s_fw, vec3f(y * 0.21 + o.zx, o.y + zt * 1.3), 0.0);
            let f1 = pow(vec4f(1.0) - abs(2.0 * n1 - vec4f(1.0)), vec4f(7.0));
            let f2 = pow(vec4f(1.0) - abs(2.0 * n2 - vec4f(1.0)), vec4f(10.0));
            let fil = f1 * 0.8 + f2 * 0.6;
            // Sight lines through the thick shell (limb-brightened).
            let s1 = 2.0 * (sqrt(max(1.0 - rr * rr, 0.0)) - sqrt(max(0.67 - rr * rr, 0.0)));
            let s2 = 2.0 * (sqrt(max(0.86 - rr * rr, 0.0)) - sqrt(max(0.5 - rr * rr, 0.0)));
            let body = smoothstep(0.95, 0.2, rr);
            let edge = smoothstep(1.06, 0.97, rr);
            // Surface brightness falls as the shell spreads.
            let bright = w * pow(0.32 / R, 0.25) * (1.0 + 0.35 * sb + 0.2 * pb);
            // The kicks' shocks, lighting the filaments as they pass.
            let k1 = rr - sk.x;
            let k2 = rr - sk.z;
            let shock = 1.0 + 1.6 * (sk.y * exp(-k1 * k1 / 0.006) + sk.w * exp(-k2 * k2 / 0.006));
            var c = (cr * fil.r * s1 * 2.0 + ct * fil.g * s2 * 1.8 + cg * fil.b * body * 0.9) * shock;
            // A diffuse glow under the filaments.
            c += (cr * 0.22 * s1 + ct * 0.1 * s2 + cg * 0.07 * body) * (0.6 + 0.8 * n1.a);
            col += c * edge * bright;
            // The pulsar wind nebula and the pulsar.
            let pr = r * R;
            let wisp = 0.6 + 0.8 * n2.a;
            col += vec3f(0.45, 0.6, 1.0) * exp(-pr * pr / (0.0035 * (1.0 + 0.6 * pb))) * wisp * (0.35 + 0.1 * pulse + 0.4 * pb) * w;
            col += vec3f(0.8, 0.9, 1.0) * exp(-pr * pr / (0.000012 * lw * lw)) * (0.5 + 0.3 * pulse) * w;
        }
    }
}
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.2, vec3f(0.0));
return col / (1.0 + 0.5 * col);
'''
