# Newton Fractal: the basins of attraction of Newton's method. Every
# point of the plane is a first guess at a root of a fifth-degree
# polynomial; Newton's method carries it to one of the five roots, and
# the point is coloured by the root it reaches. The basins are dark
# jewels, emerald, sapphire, ruby, amethyst and topaz, and where they
# meet, the boundary is a fractal: every point on it touches all five
# basins, so it splits into chains of ever smaller beads, glowing
# brighter the longer Newton's method dithers there before it settles.
# The roots themselves are small bright stars, and they wander slowly,
# so the whole lacework swirls and reshapes around them.
#
# Everything is in the composite. For p(z) = (z - r1)...(z - r5),
# p / p' = 1 / sum 1 / (z - rk), so each step is z -= a / sum 1/(z - rk),
# up to 40 steps until z is within 0.001 of a root. The relaxation a
# drifts slowly near 1 for the first eight steps, which loosens the
# boundaries into lace (after that a = 1, so the end converges fast). The
# iteration count, smoothed by how far past the tolerance the last step
# landed (Newton converges quadratically, so log2 of the ratio of the
# logs), shades the boundaries from the basin's tint through a hue shift
# to white. The roots move on slow Lissajous paths whose phase the frame
# code accumulates.
#
# Bass quickens the roots a little and swells the boundary glow
# (smoothed). Mids turn the hue shift along the iteration count. Treble
# twinkles the stars. Each kick makes the stars flare, eased.
version = 1

[meta]
name = "Newton Fractal"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
ph = 0; hs = 0; vr = 0;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb_att, 2.5) - st) * 0.1;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.08;
// The roots' clock (accumulated, a little faster with the bass), wrapped
// at a whole period of every path below (all frequencies are multiples
// of 1/20).
ph = ph + (0.05 + 0.025 * min(sb, 2) / 2) / 60;
ph = ph - 20 * floor(ph / 20);
w = 6.2831853 * ph;
// Five roots spread round a ring that turns slowly, each wandering in
// angle and radius on its own path.
k = 0;
loop(5,
  th = 1.2566371 * k + 0.2 * w + 0.55 * sin(w * (0.15 + 0.05 * k) + 1.3 * k);
  rr = 0.82 + 0.32 * sin(w * (0.35 - 0.05 * k) + 2.1 * k);
  megabuf(k * 2) = rr * cos(th); megabuf(k * 2 + 1) = rr * sin(th);
  k = k + 1
);
q1 = megabuf(0); q2 = megabuf(1); q3 = megabuf(2); q4 = megabuf(3);
q5 = megabuf(4); q6 = megabuf(5); q7 = megabuf(6); q8 = megabuf(7);
q9 = megabuf(8); q10 = megabuf(9);
// The relaxation, near 1.
q11 = 1.0 + 0.07 * sin(w * 0.05 + 1.0);
q12 = 0.1 * sin(w * 0.1 + 0.2);
// The hue shift along the iteration count (accumulated, mids quicken it).
hs = hs + (0.01 + 0.03 * min(sm, 2) / 2) / 60;
hs = hs - floor(hs);
// The view turns very slowly.
vr = vr + 6.2831853 / 240 / 60;
vr = vr - 6.2831853 * floor(vr / 6.2831853);
q13 = hs; q14 = vr;
q17 = sb; q18 = st; q19 = be;
'''

[shader]
comp = '''
let asp = u.texsize.x * u.texsize.w;
let sb = min(u.q[4].x, 2.0) * 0.5;
let st = max(0.0, min(u.q[4].y, 2.5) - 0.3);
let be = min(u.q[4].z, 1.0);
let hs = u.q[3].x;
let vr = u.q[3].y;
let px = u.texsize.w;
let lw = max(1.0, u.texsize.y / 540.0);
// The plane: 2.5 units across the screen height, turning slowly.
let p0 = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y) * 2.5;
let cv = cos(vr);
let sv = sin(vr);
let p = vec2f(cv * p0.x - sv * p0.y, sv * p0.x + cv * p0.y);
var rt: array<vec2f, 5>;
rt[0] = u.q[0].xy;
rt[1] = u.q[0].zw;
rt[2] = u.q[1].xy;
rt[3] = u.q[1].zw;
rt[4] = u.q[2].xy;
let ra = u.q[2].zw;
var tint: array<vec3f, 5>;
tint[0] = vec3f(0.1, 1.0, 0.45);
tint[1] = vec3f(0.15, 0.45, 1.0);
tint[2] = vec3f(1.0, 0.12, 0.3);
tint[3] = vec3f(0.7, 0.2, 1.0);
tint[4] = vec3f(1.0, 0.65, 0.1);
// Newton's method.
var z = p;
var n = 40.0;
var hit = -1;
var dd = 1.0;
let tol = 0.001;
for (var i = 0; i < 40; i++) {
    var s = vec2f(0.0);
    var near = 1e9;
    var kn = 0;
    for (var k = 0; k < 5; k++) {
        let e = z - rt[k];
        let m = dot(e, e);
        if (m < near) {
            near = m;
            kn = k;
        }
        s += vec2f(e.x, -e.y) / max(m, 1e-20);
    }
    if (near < tol * tol) {
        hit = kn;
        n = f32(i);
        dd = sqrt(near);
        break;
    }
    // z -= a / s.
    let ms = max(dot(s, s), 1e-20);
    let inv = vec2f(s.x, -s.y) / ms;
    // Relaxed only for the first steps, so the end converges quadratically.
    let a = select(vec2f(1.0, 0.0), ra, i < 8);
    z -= vec2f(a.x * inv.x - a.y * inv.y, a.x * inv.y + a.y * inv.x);
}
var col = vec3f(0.006, 0.006, 0.014);
if (hit >= 0) {
    // Smooth count: quadratic convergence, so log2 of the ratio of logs.
    let f = clamp(log2(max(log(max(dd, 1e-12)) / log(tol), 1.0)), 0.0, 1.0);
    // Far out, a fifth-degree Newton step only shrinks z by about 4/5, so
    // the count grows with the distance; take that part off.
    let cen = (rt[0] + rt[1] + rt[2] + rt[3] + rt[4]) * 0.2;
    let far = max(log(length(p - cen) / 1.05) / 0.2231, 0.0);
    let ns = max(n - f - far, 0.0);
    let c0 = tint[hit];
    // The basin: a dark jewel, a little lighter toward its rim.
    let e = smoothstep(1.0, 9.0, ns);
    col = c0 * (0.1 + 0.16 * e * e);
    // The boundary glow, the hue shifting with the count.
    let g = pow(smoothstep(3.0, 17.0, ns), 1.25);
    let hh = 6.2831853 * (hs + ns * 0.045);
    let shift = 0.5 + 0.5 * vec3f(cos(hh), cos(hh - 2.094), cos(hh + 2.094));
    let gc = mix(c0, shift, 0.45);
    col += gc * g * (1.4 + 0.8 * sb) + vec3f(1.0, 0.97, 0.92) * pow(g, 4.0) * (0.6 + 0.4 * sb);
} else {
    col = vec3f(0.9, 0.9, 1.0) * (0.7 + 0.3 * sb);
}
// The roots: small bright stars with four short spikes.
let ps = u.texsize.y / 2.5;
for (var k = 0; k < 5; k++) {
    let d = (p - rt[k]) * ps / lw;
    let r2 = dot(d, d);
    let tw = 0.8 + 0.2 * sin(u.time * (3.0 + f32(k)) + f32(k) * 1.7) * min(st, 1.0);
    let fl = 1.0 + 0.8 * be;
    let core = exp(-r2 / 6.0) * 2.0;
    let halo = exp(-sqrt(r2) / 9.0) * 0.4;
    let ax = abs(d.x);
    let ay = abs(d.y);
    let spike = (exp(-ay * ay / 0.8) * exp(-ax / (13.0 * fl)) + exp(-ax * ax / 0.8) * exp(-ay / (13.0 * fl))) * 0.6;
    col += mix(tint[k], vec3f(1.0), 0.6) * (core + halo * fl + spike) * tw;
}
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.15, vec3f(0.0));
return col / (1.0 + 0.45 * col);
'''
