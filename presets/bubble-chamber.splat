# Bubble Chamber: the tracks of charged particles in a bubble chamber's
# magnetic field. A collision vertex sprays a fan of tracks that shoot
# out from it and curl: each particle bends by a curvature proportional
# to the field over its momentum, and as it loses energy in the liquid
# its momentum falls and it curls ever tighter, so the soft ones wind
# into spirals while the hard ones barely bend. Positive and negative
# particles curl opposite ways and glow in opposite colours. The tracks
# are chains of bubbles, which glitter with the treble, and they fade
# away as the chamber resets.
#
# Each of four custom waves draws one vertex's spray: eight tracks of 64
# points, integrated point by point (the turning angle in closed form,
# theta = theta0 + (B q / k) (-ln(1 - k s / p0)) for momentum falling
# linearly with distance s), with invisible pen-up points between
# tracks. A new collision takes the oldest slot, which has faded out by
# then; its tracks grow out of the vertex over half a second, and a
# small flash (a shape) blooms and fades at the vertex.
#
# Bass strengthens the field (smoothed), so every visible track curls
# tighter or relaxes. Mids set how many tracks each collision sprays.
# Treble makes the bubbles glitter. Kicks set off the collisions (at most
# one every 1.2 seconds; one every 2.5 seconds without).
version = 1

[meta]
name = "Bubble Chamber"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "fp16"
decay = 1.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [16, 12]
b1n = 0.0
b1x = 3.0

[code]
init = '''
a0 = 9; a1 = 9; a2 = 9; a3 = 9;
q3 = 9; q7 = 9; q11 = 9; q15 = 9;
slot = 3;
ht = 200;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.04;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb, 2.5) - st) * 0.15;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.15;
a0 = a0 + 1 / 60; a1 = a1 + 1 / 60; a2 = a2 + 1 / 60; a3 = a3 + 1 / 60;
// A new collision on a kick (at most every 1.2 s), or every 2.5 s, in
// the oldest slot.
ht = ht + 1;
if(ht > 72 && (be > 0.5 || ht > 150),
  slot = (slot + 1) % 4;
  nx = (rand(1000) / 1000 - 0.5) * 1.1;
  ny = (rand(1000) / 1000 - 0.5) * 0.6;
  ns = rand(100000) / 1000;
  if(slot == 0, v0x = nx; v0y = ny; s0 = ns; a0 = 0, 0);
  if(slot == 1, v1x = nx; v1y = ny; s1 = ns; a1 = 0, 0);
  if(slot == 2, v2x = nx; v2y = ny; s2 = ns; a2 = 0, 0);
  if(slot == 3, v3x = nx; v3y = ny; s3 = ns; a3 = 0, 0);
  ht = 0,
  0);
hu = hu + 0.0003;
hu = hu - floor(hu);
q1 = v0x; q2 = v0y; q3 = a0; q4 = s0;
q5 = v1x; q6 = v1y; q7 = a1; q8 = s1;
q9 = v2x; q10 = v2y; q11 = a2; q12 = s2;
q13 = v3x; q14 = v3y; q15 = a3; q16 = s3;
// The field (smoothed with the bass) and the number of tracks (mids).
q17 = 1.3 + 0.9 * min(sb, 2) / 2;
q18 = 3.5 + 4.5 * min(sm, 2) / 2;
q19 = st; q20 = be; q21 = hu;
'''
[[wave]]
enabled = true
samples = 512
thick = 1
additive = 1
frame = '''
a = 1;
'''
point = '''
j = floor(sample * 511 + 0.5);
tr = floor(j / 64);
m = j - tr * 64;
ag = q3;
// This track's particle, from the collision's seed.
hs = q4 * 1.731 + tr * 7.123;
h1 = sin(hs * 12.9898) * 43758.5453; h1 = h1 - floor(h1);
h2 = sin(hs * 78.233) * 24634.6345; h2 = h2 - floor(h2);
h3 = sin(hs * 39.425) * 15731.7431; h3 = h3 - floor(h3);
p0 = 0.08 + 2.2 * h1 * h1;
ch = if(h2 < 0.5, 1, -1);
kl = 0.1 + 0.25 * h3;
th0 = q4 * 0.37 + tr * 0.785 + 0.6 * (h2 - 0.5);
// The track grows out of the vertex, then stops where the particle
// ranges out.
ln = min(min(ag * 3.2, 0.93 * p0 / kl), 2.4);
ds = ln / 61;
s = max((m - 1) * ds, 0);
th = th0 - ch * q17 / kl * log(max(1 - kl * s / p0, 0.02));
px = if(m <= 1, q1, px + cos(th) * ds);
py = if(m <= 1, q2, py + sin(th) * ds);
x = 0.5 + px * aspecty;
y = 0.5 + py;
// Colour by charge, fading with age; tracks beyond the mids' count are
// hidden.
hh = q21 + if(ch > 0, 0.95 + 0.1 * h3, 0.45 + 0.1 * h3);
r = 0.5 + 0.5 * cos(6.2831853 * hh);
g = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.333));
b = 0.5 + 0.5 * cos(6.2831853 * (hh - 0.667));
r = r * r; g = g * g; b = b * b;
fd = max(0, 1 - ag / 4.6);
a = if(m == 0 || m == 63, 0, fd * fd * (0.75 + 0.5 * h1) * min(max(q18 - tr, 0), 1));
'''

[[wave]]
enabled = true
samples = 512
thick = 1
additive = 1
frame = '''
a = 1;
'''
point = '''
j = floor(sample * 511 + 0.5);
tr = floor(j / 64);
m = j - tr * 64;
ag = q7;
// This track's particle, from the collision's seed.
hs = q8 * 1.731 + tr * 7.123;
h1 = sin(hs * 12.9898) * 43758.5453; h1 = h1 - floor(h1);
h2 = sin(hs * 78.233) * 24634.6345; h2 = h2 - floor(h2);
h3 = sin(hs * 39.425) * 15731.7431; h3 = h3 - floor(h3);
p0 = 0.08 + 2.2 * h1 * h1;
ch = if(h2 < 0.5, 1, -1);
kl = 0.1 + 0.25 * h3;
th0 = q8 * 0.37 + tr * 0.785 + 0.6 * (h2 - 0.5);
