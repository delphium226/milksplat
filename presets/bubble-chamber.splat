px = if(m <= 1, q9, px + cos(th) * ds);
py = if(m <= 1, q10, py + sin(th) * ds);
x = 0.5 + px * aspecty;
y = 0.5 + py;
// Colour by charge, fading with age; tracks beyond the mids' count are
// hidden.
