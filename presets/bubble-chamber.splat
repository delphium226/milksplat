# The flash at each new vertex.
[[shape]]
enabled = true
sides = 24
instances = 4
additive = 1
border_a = 0.0
frame = '''
vx = if(instance < 1, q1, if(instance < 2, q5, if(instance < 3, q9, q13)));
vy = if(instance < 1, q2, if(instance < 2, q6, if(instance < 3, q10, q14)));
ag = if(instance < 1, q3, if(instance < 2, q7, if(instance < 3, q11, q15)));
x = 0.5 + vx * aspecty;
y = 0.5 + vy;
rad = 0.012 + 0.03 * min(ag * 4, 1);
e = min(ag * 10, 1) * exp(-ag * 2.2);
r = 1; g = 0.9; b = 0.75; a = 0.5 * e;
r2 = 0.6; g2 = 0.4; b2 = 1; a2 = 0;
'''

[shader]
warp = '''
// A brief afterglow behind the tracks.
return textureSampleLevel(sampler_main, s_fc, uv_orig, 0.0).rgb * 0.72;
'''
comp = '''
let asp = u.texsize.x * u.texsize.w;
let st = max(0.0, min(u.q[4].z, 2.5) - 0.4);
let be = min(u.q[4].w, 1.0);
let p = (uv - vec2f(0.5)) * vec2f(asp, 1.0);
// The chamber: dark liquid, faintly lit from the middle, with a ghost
// of the glass's texture.
let gn = textureSampleLevel(sampler_noise_lq, s_fw, uv * vec2f(asp, 1.0) * 0.7, 0.0).x;
var col = vec3f(0.013, 0.027, 0.045) * (1.0 + 1.8 * exp(-dot(p, p) * 2.5)) + vec3f(0.004, 0.008, 0.012) * gn;
// A faint grid of fiducial crosses on the chamber's window.
let gp = p * 4.0;
let gc = abs(gp - round(gp));
let cross = max(exp(-gc.x * 160.0) * step(gc.y, 0.06), exp(-gc.y * 160.0) * step(gc.x, 0.06));
col += vec3f(0.05, 0.08, 0.1) * cross;
// The tracks, as chains of bubbles that glitter with the treble.
let c = textureSampleLevel(sampler_main, s_fc, uv, 0.0).rgb;
let bn = textureSampleLevel(sampler_noise_hq, s_pw, uv * u.texsize.xy / 512.0, 0.0).x;
let bub = 0.55 + 0.7 * bn + st * 1.2 * smoothstep(0.75, 0.95, bn);
col += (vec3f(1.0) - exp(-c * 1.8)) * bub * 1.15;
let b1 = GetBlur1(uv);
col += (1.0 - exp(-b1 * 1.6)) * (0.55 + 0.25 * be);
let lc = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lc) + (col - vec3f(lc)) * 1.3, vec3f(0.0));
return col / (1.0 + 0.3 * col);
'''
