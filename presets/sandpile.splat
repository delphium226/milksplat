# Abelian Sandpile: grains of sand drop one after another on the centre of
# a grid. Any square holding four or more grains topples, giving one to
# each of its four neighbours, which may topple in turn, and the
# avalanches carry the sand outward. The pile that grows is the famous
# sandpile fractal: an eight-sided disc of nested triangles, patches and
# stripes with near-perfect symmetry, every square at rest holding 0, 1,
# 2 or 3 grains, shown in four neon colours, violet, cyan, magenta and
# gold, with a white-hot heart where the sand is falling. When it fills
# the screen it holds for a moment, fades away, and a new pile begins.
#
# The grid lives in the fp16 feedback buffer (whole numbers of grains are
# exact in half floats), one texel a cell in the buffer's top left
# corner: 150 cells down (or the buffer's height, if smaller) and as many
# across as keep them square on screen. Each tick the warp shader adds
# the tick's grains to the centre and runs four rounds of toppling: in a
# round every cell topples as many times as it can at once,
# h -> h mod 4 + the sum of floor(h' / 4) over its neighbours, which by
# the abelian property ends in the same pile as toppling one at a time.
# Four rounds in one pass read the 41 cells within four steps of the
# cell and work inward (with fixed loop bounds, so it all unrolls into
# registers). The other channels keep whether a cell has ever
# held sand and a smoothed measure of how busy it is. If the buffer is
# resized (the quality governor), the frame code fades the pile out
# quickly and starts a new one.
#
# The composite draws each cell as a small glowing tile coloured by its
# grains, with the hot toppling core and a soft halo round the pile. The
# frame code counts the grains and runs the cycle: grow until the pile,
# at the sandpile's density of about 2.125 grains a cell, would be 0.48
# of the screen height in radius, hold 8 s (while the last of it
# settles), fade out over 3 s, clear, and start again (there is a fast
# burst at the start so the screen is never bare).
#
# Bass pours the sand faster and brightens the colours and the dusk
# behind (smoothed). Mids swell the halo. Each kick makes the falling
# core flare, eased.
version = 1

[meta]
name = "Abelian Sandpile"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "fp16"
decay = 1.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
ph = 0; ng = 0; ht = 0; fd = 0; fi = 1; fc = 0; rs = 1;
lx = pixelsx; ly = pixelsy;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.08;
// The grid: 150 cells down (fewer in a tiny buffer); the pile is full
// at 0.48 of that in radius.
ny = min(150, pixelsy);
full = 2.125 * 3.14159265 * pow(0.48 * ny, 2);
rs = 0;
fc = fc + 1;
dr = 0;
// A resized buffer has blurred the grid: fade out fast and start anew.
if(pixelsx != lx || pixelsy != ly,
  if(ph < 1.5, ph = 2; fd = 0.67, fd = max(fd, 0.67)),
  0);
lx = pixelsx; ly = pixelsy;
// Growing: the grains this tick (whole grains), a burst at the start.
if(ph < 0.5,
  dr = floor(20 + 24 * min(sb, 2) / 2 + 150 * exp(-fc / 120));
  ng = ng + dr;
  if(ng >= full, ph = 1; ht = 0, 0),
  0);
// Holding.
if(ph > 0.5 && ph < 1.5,
  ht = ht + 1 / 60;
  if(ht > 8, ph = 2; fd = 0, 0),
  0);
// Fading out, then clearing for a new pile.
if(ph > 1.5,
  fd = fd + 1 / 180;
  if(fd >= 1, ph = 0; ng = 0; fd = 0; fc = 0; fi = 0; rs = 1, 0),
  0);
fi = min(1, fi + 1 / 60);
q1 = rs || fc < 3; q2 = dr;
// How far out the sand reaches (cells).
q3 = sqrt(ng / 6.676);
q4 = fi * (1 - fd);
q5 = sb; q6 = sm; q7 = be;
q8 = dr;
'''

[shader]
warp = '''
let sz = u.texsize.xy;
// The grid, one texel a cell in the top left corner.
let ny = min(150.0, sz.y);
let nc = vec2f(floor(ny * sz.x / sz.y), ny);
let c = floor(uv_orig * sz);
if (u.q[0].x > 0.5 || c.x >= nc.x || c.y >= nc.y) {
    return vec3f(0.0);
}
let cc = floor(nc * 0.5);
let dc = c - cc;
let rmax = u.q[0].z * 1.15 + 10.0;
if (dot(dc, dc) > rmax * rmax) {
    return vec3f(0.0);
}
let here = textureLoad(sampler_main, vec2i(c), 0).rgb;
let drop = u.q[0].y;
// The cells within four steps (9x9 grids, index
// (dy + 4) * 9 + dx + 4; every loop has fixed bounds, so the compiler
// unrolls it all and keeps the cells in registers).
var a: array<f32, 81>;
var b: array<f32, 81>;
for (var dy = -4; dy <= 4; dy++) {
    for (var dx = -4; dx <= 4; dx++) {
        let i = (dy + 4) * 9 + dx + 4;
        var v = 0.0;
        if (abs(dx) + abs(dy) <= 4) {
            let q = c + vec2f(f32(dx), f32(dy));
            if (q.x >= 0.0 && q.y >= 0.0 && q.x < nc.x && q.y < nc.y) {
                v = textureLoad(sampler_main, vec2i(q), 0).r;
                if (q.x == cc.x && q.y == cc.y) {
                    v += drop;
                }
            }
        }
        a[i] = v;
        b[i] = v;
    }
}
// Four rounds of toppling, each needing one step less of the diamond.
for (var k = 1; k <= 4; k++) {
    for (var dy = -4; dy <= 4; dy++) {
        for (var dx = -4; dx <= 4; dx++) {
            if (abs(dx) + abs(dy) <= 4 - k) {
                let i = (dy + 4) * 9 + dx + 4;
                let h = a[i];
                b[i] = h - 4.0 * floor(h * 0.25) + floor(a[i - 1] * 0.25) + floor(a[i + 1] * 0.25) + floor(a[i - 9] * 0.25) + floor(a[i + 9] * 0.25);
            }
        }
    }
    for (var i = 0; i < 81; i++) {
        a[i] = b[i];
    }
}
let hn = a[40];
let seen = max(here.g, step(0.5, hn));
let busy = mix(here.b, clamp((hn - 3.0) / 24.0, 0.0, 1.0), 0.12);
return vec3f(hn, seen, busy);
'''
comp = '''
let sz = u.texsize.xy;
let fade = u.q[0].w;
let sb = min(u.q[1].x, 2.0) * 0.5;
let sm = min(u.q[1].y, 2.0) * 0.5;
let be = min(u.q[1].z, 1.0);
let ny = min(150.0, sz.y);
let nc = vec2f(floor(ny * sz.x / sz.y), ny);
let cp = uv * nc;
let c = min(floor(cp), nc - vec2f(1.0));
let fr = cp - floor(cp);
let st = textureLoad(sampler_main, vec2i(c), 0).rgb;
let h = st.r;
// The four colours of a cell at rest.
var cc = vec3f(0.35, 0.08, 0.85);
if (h > 0.5) {
    cc = vec3f(0.0, 0.85, 1.0);
}
if (h > 1.5) {
    cc = vec3f(1.0, 0.1, 0.6);
}
if (h > 2.5) {
    cc = vec3f(1.0, 0.62, 0.05);
}
// A small tile with a dark seam, when cells are big enough to show one
// (sz.y / ny pixels of the buffer a cell).
let px = sz.y / ny;
let e = clamp(1.0 / px, 0.0, 0.5);
let tx = smoothstep(0.0, e, fr.x) * smoothstep(1.0, 1.0 - e, fr.x);
let ty = smoothstep(0.0, e, fr.y) * smoothstep(1.0, 1.0 - e, fr.y);
let tile = mix(1.0, 0.4 + 0.6 * tx * ty, smoothstep(2.5, 4.0, px));
var col = vec3f(0.005, 0.005, 0.016);
col += cc * st.g * tile * (1.25 + 0.5 * sb);
// The toppling heart: white-hot where the sand is busy.
let busy = clamp(st.b * 2.0, 0.0, 1.0);
col = mix(col, vec3f(1.0, 0.95, 0.85) * (1.2 + 0.6 * be), busy * 0.85);
// A soft violet halo round the pile: how many cells 5 and 10 steps away
// in eight directions hold sand.
var near = 0.0;
for (var j = 0; j < 8; j++) {
    let an = f32(j) * 0.7853982 + 0.39;
    let dv = vec2f(cos(an), sin(an));
    let p1 = clamp(c + floor(dv * 5.0 + 0.5), vec2f(0.0), nc - vec2f(1.0));
    let p2 = clamp(c + floor(dv * 10.0 + 0.5), vec2f(0.0), nc - vec2f(1.0));
    near += textureLoad(sampler_main, vec2i(p1), 0).g * 0.6 + textureLoad(sampler_main, vec2i(p2), 0).g * 0.4;
}
col += vec3f(0.35, 0.12, 0.9) * (near / 8.0) * (0.2 + 0.15 * sm);
let r = length(cp - nc * 0.5);
// A deep violet dusk behind it all, a little brighter with the bass.
col += vec3f(0.05, 0.015, 0.13) * (0.25 + 0.75 * sb) * exp(-r * r / (ny * ny * 0.5));
col += vec3f(1.0, 0.7, 0.4) * exp(-r * r / (90.0 + 90.0 * be)) * min(u.q[1].w / 30.0, 1.0) * (0.5 + 0.6 * be);
col *= fade;
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.25, vec3f(0.0));
return col / (1.0 + 0.4 * col);
'''
