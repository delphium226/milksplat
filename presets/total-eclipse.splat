# Total Eclipse: the moment of totality. High in a deep star field the
# moon is a black disc, and round it blazes the sun's corona: pearly
# white-gold light combed into long streamers, two great helmet streamers
# reaching out along the equator and fine plumes at the poles, with
# ragged magenta prominences licking up from the limb and a thin pink
# rim of chromosphere. Low on every side the sky glows with the orange
# and teal of a false dusk above a black horizon. The moon drifts very
# slowly across the sun, so every half a minute or so totality ends at
# one edge: the jagged lunar limb lets the last light through in a row
# of Baily's beads, then one bead blazes into the diamond ring, before
# the moon swings back and totality returns.
#
# Everything is in the composite. The corona is a power law in radius,
# combed in angle by noise (streamers sampled at whole-number angular
# frequencies, so they wrap round the circle; fine filaments faster;
# helmet streamers along the tilted equator), coloured from gold-white
# to pearl with distance. The prominences are noise tongues above the
# limb, the beads the sun's disc showing past a noisy moon limb, the
# diamond ring a glow with diffraction spikes where the sun shows most.
# Coronal mass ejections are expanding loops anchored on the limb.
#
# The frame code accumulates the moon's drift, the corona's slow turning
# and the prominences' flow, and runs the ejections. Each hit of the
# music is felt at once, through pulses of the bass, mids and treble that
# rise in a tick or two and die away over a fraction of a second
# (soft-limited, so a bigger hit still means more): a kick swells the
# corona and flares the prominences, launches a coronal mass ejection at
# a random angle (up to three at once) and pushes the view in; the mids
# brighten the streamers' fine filaments; the treble twinkles the stars.
# Bass brightens the corona (smoothed).
version = 1

[meta]
name = "Total Eclipse"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
ec = 0.6; cr = 0; pf = 0; sw = 0; cd = 0; sl = 0;
t1 = 0; r1 = 9; a1 = 0; t2 = 0; r2 = 9; a2 = 0; t3 = 0; r3 = 9; a3 = 0;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
// The per-hit pulses: fast attack, slower decay, soft-limited.
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
ob = pb;
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
kk = max(pb - ob, 0);
// The corona's swell: up with the kicks, back over a second or so.
sw = sw + (pb - sw) * if(pb > sw, 0.5, 0.04);
// The moon's slow drift across the sun (once each way in about 45 s).
ec = ec + 0.0023; ec = ec - 6.2831853 * floor(ec / 6.2831853);
se = sin(ec);
mo = 0.016 * sign(se) * pow(abs(se), 8);
cr = cr + 0.0004 + 0.0015 * pb; cr = cr - 6.2831853 * floor(cr / 6.2831853);
pf = pf + 0.004 + 0.012 * pb + 0.004 * pm; pf = pf - 1024 * floor(pf / 1024);
// A fresh kick launches a coronal mass ejection, in the next of three
// slots.
cd = cd + 1;
if(kk > 0.1 && cd > 10,
  cd = 0; sl = (sl + 1) % 3;
  na = 6.2831853 * rand(1000) / 1000;
  if(sl == 0, t1 = na; r1 = 1; a1 = 0.4, 0);
  if(sl == 1, t2 = na; r2 = 1; a2 = 0.4, 0);
  if(sl == 2, t3 = na; r3 = 1; a3 = 0.4, 0),
  0);
nb = min(0.4 + pb, 1.4);
if(r1 < 1.3, a1 = max(a1, nb), 0); if(r2 < 1.3, a2 = max(a2, nb), 0); if(r3 < 1.3, a3 = max(a3, nb), 0);
r1 = min(r1 + 0.035, 9); r2 = min(r2 + 0.035, 9); r3 = min(r3 + 0.035, 9);
a1 = a1 * 0.975; a2 = a2 * 0.975; a3 = a3 * 0.975;
q1 = mo; q2 = cr; q3 = pf; q4 = sw;
q5 = pb; q6 = pm; q7 = pt; q8 = sb;
q9 = t1; q10 = r1; q11 = a1;
q13 = t2; q14 = r2; q15 = a2;
q17 = t3; q18 = r3; q19 = a3;
'''

[shader]
comp = '''
let sz = u.texsize.xy;
let asp = sz.x / sz.y;
let px = 1.0 / sz.y;
let lw = max(1.0, sz.y / 540.0);
let mo = u.q[0].x;
let crt = u.q[0].y;
let pf = u.q[0].z;
let sw = u.q[0].w;
let pb = u.q[1].x;
let pm = u.q[1].y;
let pt = u.q[1].z;
let sb = min(u.q[1].w, 2.0) * 0.5;
let gk = min(1.0, sz.y / 200.0);
let zf = 1.0 / (1.0 + 0.05 * pb);
let p = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y) * zf;
let sun = vec2f(0.0, 0.06);
let rs = 0.15;
let rm = 0.154;
let moon = sun + vec2f(mo, mo * 0.35);
let v = p - sun;
let r = length(v);
let x = r / rs;
let th = atan2(v.y, v.x);
let tu = th / 6.2831853 + 0.5;
// The sky: black above, a false dusk glowing low all round.
var col = vec3f(0.002, 0.003, 0.012);
let hy = -0.4 + 0.02 * sin(p.x * 5.0 + 1.0) + 0.012 * sin(p.x * 17.0);
col += vec3f(0.02, 0.06, 0.12) * exp(-(p.y - hy) / 0.25);
col += vec3f(0.95, 0.35, 0.08) * exp(-(p.y - hy) / 0.05) * 0.35;
// The stars, twinkling with the treble.
let sc = floor(uv * sz / (1.5 * lw));
let h0 = (u32(sc.x) * 1973u + u32(sc.y) * 9277u + 7u) * 747796405u + 2891336453u;
let h1 = ((h0 >> ((h0 >> 28u) + 4u)) ^ h0) * 277803737u;
let hh = f32((h1 >> 22u) ^ h1) / 4294967296.0;
let tw = 0.7 + 0.3 * sin(u.time * (1.0 + 3.0 * hh) + hh * 50.0);
let scol = mix(vec3f(0.7, 0.8, 1.0), vec3f(1.0, 0.8, 0.6), fract(hh * 97.0));
col += scol * step(0.996, hh) * (0.3 + 0.7 * fract(hh * 911.0)) * (tw + 1.2 * pt * step(0.5, fract(hh * 53.0))) * smoothstep(hy, hy + 0.1, p.y);
// The corona: a power law in radius, swelling with the kicks.
let swl = 1.0 + 0.35 * sw;
let xs = max(x / swl, 1.0);
let tilt = 0.35 + crt;
let ce = cos(th - tilt);
let eq = ce * ce;
// Streamers: a few broad ones from whole-number harmonics in angle (so
// they wrap round), bending gently with height, and fine filaments.
let bnd = 0.05 * (xs - 1.0);
let s1 = 0.5 + 0.5 * (0.5 * cos(3.0 * th + 1.3 + crt + bnd) + 0.3 * cos(5.0 * th + 4.1 - crt * 1.3) + 0.2 * cos(8.0 * th + 2.2 + bnd * 2.0));
let s2 = textureSampleLevel(sampler_noise_lq, s_fw, vec2f(tu, 0.53 + 0.01 * x), 0.0).r;
let fi = textureSampleLevel(sampler_noise_hq, s_fw, vec2f(tu, 0.81 + 0.002 * x), 0.0).r;
let helm = pow(eq, 5.0) * exp(-(xs - 1.0) * 0.45);
let strm = 0.15 + 1.2 * pow(s1, 3.0) + 0.5 * pow(s2, 2.0);
let fil = 0.8 + (0.35 + 0.6 * pm) * (fi - 0.5) * 2.0;
let pol = pow(abs(sin(th - tilt)), 10.0) * (0.5 + 1.0 * fi) * exp(-(xs - 1.0) * 1.4);
var cor = (0.38 * pow(xs, -4.5) + 0.3 * pow(xs, -2.4) * strm * (0.45 + 0.55 * eq)) * fil + 0.45 * helm * strm * fil + 0.25 * pol;
cor *= (0.9 + 0.3 * sb + 0.4 * sw);
let ccol = mix(vec3f(1.0, 0.82, 0.55), vec3f(0.85, 0.88, 1.0), smoothstep(1.0, 3.0, x));
col += ccol * cor * smoothstep(0.98, 1.03, x) * 1.1;
// Coronal mass ejections: loops swelling out from the limb.
for (var i = 0; i < 3; i++) {
    let cq = u.q[2 + i];
    if (cq.z > 0.01) {
        let dirv = vec2f(cos(cq.x), sin(cq.x));
        let rr = cq.y;
        let cc = sun + dirv * rs * (1.0 + 0.55 * (rr - 1.0));
        let rad = rs * 0.15 + rs * 0.5 * (rr - 1.0);
        let dd = length(p - cc) - rad;
        let side = smoothstep(-0.1, 0.4, dot(normalize(p - sun + vec2f(1e-5)), dirv));
        let shell = exp(-dd * dd / (0.0004 + 0.0012 * rr)) + 0.25 * exp(-max(-dd, 0.0) / 0.02) * step(dd, 0.0);
        col += mix(vec3f(1.0, 0.35, 0.75), vec3f(0.9, 0.9, 1.0), smoothstep(1.0, 3.0, rr)) * shell * side * cq.z * (1.0 - smoothstep(1.6, 3.8, rr)) * 1.6 * smoothstep(0.98, 1.05, x);
    }
}
// The prominences: magenta tongues above the limb, flaring with the
// kicks.
let al = r - rs;
if (al > -0.01 && al < 0.09) {
    let pn = textureSampleLevel(sampler_noise_lq, s_fw, vec2f(tu, 0.29), 0.0).r;
    let ph = (0.005 + 0.06 * pow(smoothstep(0.45, 0.85, pn), 1.3)) * (1.0 + 0.9 * sw + 0.5 * pb);
    let pr = textureSampleLevel(sampler_noise_mq, s_fw, vec2f(tu * 2.0, al * 6.0 - pf), 0.0).r;
    let pr2 = textureSampleLevel(sampler_noise_lq, s_fw, vec2f(tu * 3.0 + 0.5, al * 3.0 - pf * 0.6), 0.0).r;
    let body = smoothstep(ph, ph * 0.3, al) * smoothstep(0.3, 0.65, pr * 0.6 + pr2 * 0.4 + 0.25 - al / max(ph, 1e-3) * 0.3);
    // The chromosphere: a thin pink rim.
    let ap = al / (px * lw);
    let rim = exp(-max(ap, 0.0) / 2.5) * step(0.0, al);
    col += vec3f(1.0, 0.08, 0.5) * body * (2.2 + 3.0 * pb) + vec3f(1.0, 0.3, 0.55) * rim * 0.8;
    col += vec3f(1.0, 0.5, 0.8) * body * smoothstep(ph * 0.6, 0.0, al) * 0.6;
}
// The moon: black, its limb jagged with valleys and peaks.
let vm = p - moon;
let rmo = length(vm);
let thm = atan2(vm.y, vm.x);
let ln = 0.35 * textureSampleLevel(sampler_noise_lq, s_fw, vec2f(thm / 6.2831853, 0.07), 0.0).r + 0.65 * textureSampleLevel(sampler_noise_hq, s_fw, vec2f(thm / 6.2831853, 0.41), 0.0).r;
let rml = rm - 0.0045 * ln * ln;
let inm = 1.0 - smoothstep(rml - px, rml + px, rmo);
// The sun's disc where it shows past the limb: Baily's beads.
let ins = 1.0 - smoothstep(rs - px, rs + px, r);
let bead = ins * (1.0 - inm);
col += vec3f(1.0, 0.97, 0.9) * bead * 4.0;
col = mix(col, vec3f(0.004, 0.004, 0.008), inm);
// The diamond ring: where the sun shows most.
let ex = clamp((abs(mo) * 1.06 - (rm - rs)) / 0.011, 0.0, 1.0);
if (ex > 0.0) {
    let dv = vec2f(-sign(mo), -sign(mo) * 0.35);
    let dpos = sun + normalize(dv) * rs;
    let dq = p - dpos;
    let dl = length(dq);
    let e2 = ex * ex;
    var dia = exp(-dl / 0.008) * 3.0 + exp(-dl / 0.03) * 1.0 + exp(-dl / 0.1) * 0.15;
    // Diffraction spikes.
    for (var k = 0; k < 3; k++) {
        let ak = 0.4 + f32(k) * 1.0471976;
        let a = vec2f(cos(ak), sin(ak));
        let along = dot(dq, a);
        let across = dq.x * a.y - dq.y * a.x;
        dia += exp(-abs(across) / (1.2 * px * lw)) * exp(-abs(along) / 0.07) * 0.7;
    }
    col += vec3f(1.0, 0.96, 0.88) * dia * e2 * (1.0 - 0.85 * inm);
}
// The horizon: black hills.
col *= smoothstep(hy - px, hy + px, p.y);
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.15, vec3f(0.0)) * 1.1;
return col / (1.0 + 0.45 * col);
'''
