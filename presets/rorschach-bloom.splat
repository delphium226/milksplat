# Rorschach Bloom: neon inkblots on black, mirror-symmetric about a
# vertical fold like a psychologist's ink card, that bloom, bleed and
# morph into one another: moths with spread wings, masks with hollow
# eyes, faces, beetles, butterflies. Each blot glows at its edge in one
# neon ink, pools in its thickest parts in a second, hotter ink, and is
# stained through with dark veins; at its rim the ink bleeds into the
# black in fine feathered fringes. Every so often the card is folded the
# other way too, and for a while the blots are four-way symmetric, before
# they let go of the second fold again.
#
# Everything is in the composite. The blot is a field: a broad envelope
# round the centre, its width, height and wing tilt drifting, plus a
# domain-warped fractal of the 3D noise, taken at the folded point (the
# distance from the vertical axis, and the height, or its distance from
# the horizontal axis as much as the four-way fold is in), so the shapes
# are symmetric by construction. Where the field is over zero there is
# ink; its rim is drawn crisp (from its screen-space slope) with a soft
# halo, a second threshold makes the pooled core, and a fine noise near
# the edge makes the bleeding fringes.
#
# The frame code accumulates the morph, the colours, the shape's drift
# and the four-way fold's coming and going, and keeps three blooms. Each
# hit of the music is felt at once, through pulses of the bass, mids and
# treble that rise in a tick or two and die away over a fraction of a
# second (soft-limited, so a bigger hit still means more): a kick pushes
# a fresh bloom of new-coloured ink out from a point on the fold (three
# at most at once), which spreads in lobes and fades into the blot, and
# swells the whole blot and its glowing rim and pushes the view in; the
# mids quicken the morphing and drift the colours; the treble makes the
# rim bleed further and sparkle. Bass speeds the morph a little
# (smoothed).
version = 1

[meta]
name = "Rorschach Bloom"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
mph = 0.3; hu = 0.0; m4 = 0; sh = 0; tm = 0; sl = 0; cd = 0; bph = 0;
r1 = 0; r2 = 0; r3 = 0; a1 = 0; a2 = 0; a3 = 0; y1 = 0; y2 = 0; y3 = 0;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.03;
// The per-hit pulses: fast attack, slower decay, soft-limited.
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
ob = pb;
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
// The morph and the colours, accumulated.
mph = mph + 0.0009 + 0.0035 * pm + 0.0006 * min(sb, 2);
mph = mph - floor(mph);
bph = bph + 0.002 + 0.006 * pt;
bph = bph - floor(bph);
hu = hu + 0.0003 + 0.0025 * pm;
hu = hu - floor(hu);
sh = sh + 6.2831853 / 47 / 60;
sh = sh - 6.2831853 * floor(sh / 6.2831853);
// The four-way fold: 14 s of every 45.
tm = tm + 1 / 60;
tm = tm - 45 * floor(tm / 45);
m4 = m4 + (if(tm > 26 && tm < 40, 1, 0) - m4) * 0.012;
// A fresh kick pushes a new bloom out from a point on the fold.
kk = max(pb - ob, 0);
cd = cd + 1;
if(kk > 0.1 && cd > 9,
  cd = 0; sl = (sl + 1) % 3;
  by = (rand(1000) / 1000 - 0.5) * 0.5;
  bh = hu + 0.25 + rand(1000) / 2000;
  if(sl == 0, y1 = by; r1 = 0.03; t1 = min(pb, 1.5); h1 = bh, 0);
  if(sl == 1, y2 = by; r2 = 0.03; t2 = min(pb, 1.5); h2 = bh, 0);
  if(sl == 2, y3 = by; r3 = 0.03; t3 = min(pb, 1.5); h3 = bh, 0),
  0);
// Each spreads quickly at first, then slows; its ink swells in over a
// few ticks and fades over a couple of seconds.
r1 = r1 + (0.42 - r1) * 0.04; r2 = r2 + (0.42 - r2) * 0.04; r3 = r3 + (0.42 - r3) * 0.04;
t1 = t1 * 0.975; t2 = t2 * 0.975; t3 = t3 * 0.975;
a1 = a1 + (t1 - a1) * 0.25; a2 = a2 + (t2 - a2) * 0.25; a3 = a3 + (t3 - a3) * 0.25;
q1 = mph; q2 = hu; q3 = m4; q4 = sh;
q5 = pb; q6 = pm; q7 = pt; q8 = sb;
q9 = y1; q10 = r1; q11 = a1; q12 = h1;
q13 = y2; q14 = r2; q15 = a2; q16 = h2;
q17 = y3; q18 = r3; q19 = a3; q20 = h3;
q21 = bph;
'''

[shader]
comp = '''
let sz = u.texsize.xy;
let asp = sz.x / sz.y;
let mph = u.q[0].x;
let hu = u.q[0].y;
let m4 = u.q[0].z;
let sh = u.q[0].w;
let pb = u.q[1].x;
let pm = u.q[1].y;
let pt = min(u.q[1].z, 1.5);
let sb = min(u.q[1].w, 2.0) * 0.5;
let bph = u.q[5].x;
// A kick pushes the view in.
// (Whole-picture reactions are gentler on a tiny picture, where the
// glowing rim fills much of it.)
let rq = 0.35 + 0.65 * smoothstep(60.0, 200.0, sz.y);
let zf = 1.0 / (1.0 + 0.04 * pb * rq);
let p = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y) * zf;
// The fold: distance from the vertical axis, and the height (or its
// distance from the horizontal axis, as far as the four-way fold is in).
let ax = abs(p.x);
let yy = mix(p.y, abs(p.y) - 0.1, m4);
// The envelope: a broad blot, its width, height and wing tilt drifting.
let ex = ax / (0.52 + 0.1 * sin(sh) + 0.04 * pb * rq);
let ey = (yy - 0.03 * sin(sh * 2.0 + 1.0)) / (0.38 + 0.05 * cos(sh * 3.0));
let env = 1.0 - ex * ex - ey * ey + 0.6 * sin(sh * 2.0 + 0.6) * ex * ey;
// The fractal: smooth value noise from the 3D noise (the texel weights
// eased, so the contours have no creases), domain-warped, at the folded
// point, morphing through the volume.
let w0 = vec3f(ax * 0.09 + 0.3, yy * 0.09 + 0.7, mph);
let wk = w0 * 32.0 - 0.5;
let wi = floor(wk);
var wt = wk - wi;
wt = wt * wt * (3.0 - 2.0 * wt);
let wn = textureSampleLevel(sampler_noisevol_lq, s_fw, (wi + wt + 0.5) / 32.0, 0.0).rg - vec2f(0.5);
let q = vec3f(ax * 0.22, yy * 0.22, mph) + vec3f(wn * 0.06, 0.0);
var n = 0.0;
var am = 1.0;
var sc = 1.0;
for (var o = 0; o < 3; o++) {
    let c = vec3f(q.xy * sc, q.z) + vec3f(0.17, 0.41, 0.29) * f32(o);
    let k = c * 32.0 - 0.5;
    let ki = floor(k);
    var t = k - ki;
    t = t * t * (3.0 - 2.0 * t);
    n += (textureSampleLevel(sampler_noisevol_lq, s_fw, (ki + t + 0.5) / 32.0, 0.0).r - 0.5) * am;
    am *= 0.5;
    sc *= 2.07;
}
// Finer still near the edge: the bleeding fringes.
let fk = vec3f(ax * 1.3, yy * 1.3, bph) * 64.0 - 0.5;
let fi = floor(fk);
var ft = fk - fi;
ft = ft * ft * (3.0 - 2.0 * ft);
let fr = textureSampleLevel(sampler_noisevol_hq, s_fw, (fi + ft + 0.5) / 64.0, 0.0).r - 0.5;
var f = env * 0.8 + n * 1.4 - 0.06 + 0.08 * pb * rq;
// The blooms: lobed blots of fresh ink pushed out from the fold.
var bw = 0.0;
var bc = vec3f(0.0);
for (var i = 0; i < 3; i++) {
    let bq = u.q[2 + i];
    let dv = vec2f(ax, yy - bq.x);
    let rr = length(dv);
    let ang = atan2(dv.y, dv.x);
    let lob = 0.75 + 0.15 * sin(ang * 5.0 + f32(i) * 2.0 + mph * 20.0) + 0.1 * sin(ang * 9.0 - f32(i));
    let br = bq.y * lob;
    let m = bq.z * (1.0 - smoothstep(br * 0.5, br, rr));
    f += m * 0.7;
    let h6 = 6.2831853 * bq.w;
    bc += (0.5 + 0.5 * cos(vec3f(h6, h6 - 2.094, h6 + 2.094))) * m;
    bw += m;
}
// (The fine detail gives way on a tiny picture, where it would shimmer.)
let fq = smoothstep(80.0, 250.0, sz.y);
f += fr * (0.1 + 0.12 * pt) * fq * exp(-abs(f) * 6.0);
let fw = max(fwidth(f), 1e-4);
// The inks: rim, body and pooled core, tinted by fresh blooms.
let h1 = 6.2831853 * hu;
let h2 = 6.2831853 * (hu + 0.42);
var c1 = 0.5 + 0.5 * cos(vec3f(h1, h1 - 2.094, h1 + 2.094));
var c2 = 0.5 + 0.5 * cos(vec3f(h2, h2 - 2.094, h2 + 2.094));
c1 = c1 * c1 * 1.3 + vec3f(0.04);
c2 = c2 * c2 * 1.3 + vec3f(0.04);
let bt = clamp(bw, 0.0, 1.0);
let bcol = bc / max(bw, 1e-3);
c1 = mix(c1, bcol * bcol * 1.3 + vec3f(0.05), bt * 0.85);
var col = vec3f(0.004, 0.003, 0.008) + c2 * 0.035 * exp(-length(p) * 1.5);
// A faint glow of the ink round the blot.
col += c1 * exp(-max(-f, 0.0) / 0.12) * 0.15;
// The veins and the mottling of the ink.
let vk = vec3f(ax * 0.35 + 0.2, yy * 0.35, mph) * 32.0 - 0.5;
let vi = floor(vk);
var vt = vk - vi;
vt = vt * vt * (3.0 - 2.0 * vt);
let vn = textureSampleLevel(sampler_noisevol_lq, s_fw, (vi + vt + 0.5) / 32.0, 0.0).b;
if (f > 0.0) {
    // The body: dark-stained ink, lighter toward the edge, with veins.
    let vein = 1.0 - smoothstep(0.0, 0.035, abs(vn - 0.5));
    let body = mix(c1 * 0.6, c1 * 0.24, smoothstep(0.0, 0.25, f));
    col = body * (0.8 + 0.4 * vn) + c1 * vein * 0.22;
    // The pooled core: a second, hotter ink.
    let k = f - 0.52 + 0.14 * (vn - 0.5);
    col = mix(col, c2 * (0.5 - 0.3 * smoothstep(0.0, 0.25, k) + 0.25 * vn), smoothstep(-fw, fw, k) * 0.9);
    col += c2 * exp(-abs(k) / (fw * 1.2)) * 0.6 + c2 * exp(-abs(k) / 0.04) * 0.1;
}
// The rim: crisp and glowing, brighter on the kicks.
let lw = max(0.7, sz.y / 540.0);
let rim = exp(-abs(f) / (fw * 1.3 * lw)) + exp(-abs(f) / 0.04) * 0.3;
col += mix(c1, vec3f(1.0), 0.15 + 0.25 * pt) * rim * (0.8 + (0.5 * pb + 0.3 * pm) * rq);
// The treble sparkles the bleeding fringe.
col += vec3f(1.0, 0.95, 1.0) * smoothstep(0.3, 0.42, abs(fr)) * exp(-abs(f) / 0.03) * pt * 0.5 * fq;
// The fold's crease, faint.
col += c1 * exp(-ax / (1.5 / sz.y + 0.002)) * 0.05 * (1.0 + pb) * step(0.0, f);
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.15, vec3f(0.0));
return col / (1.0 + 0.35 * col);
'''
