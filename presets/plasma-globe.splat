# Plasma Globe: the novelty lamp. Glowing filaments of plasma branch and
# writhe from a hot central electrode out to the inside of a glass sphere,
# each ending in a bright spot where it touches the glass, in a dark room.
#
# The composite shader draws eight filaments, each a curve from the
# electrode to a point on the glass. The points wander over the sphere in
# 3D, so filaments swing round the front and back (those behind are dimmer
# and hide behind the electrode) and shorten as they turn toward you. Each
# filament is displaced sideways by a few travelling sine waves that die
# away at both ends, and forks into two branches part of the way out. The
# cores are white-hot pink, wrapped in violet glow that cools to blue at
# the tips.
#
# Bass swells the plasma (thicker, brighter cores and a hotter electrode)
# and quickens the filaments' wander over the glass. Mids grow the branches
# and deepen the waves along each filament. Treble makes them crackle with
# fine, fast ripples. Each kick is a fingertip on the glass: the nearest
# filaments are drawn to one spot, which flares, then they drift apart
# again (eased in and out, at most one touch every two seconds).
version = 1

[meta]
name = "Plasma Globe"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
feedback_format = "rgba8"
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
ta = 0.8; tt = 99;
'''
frame = '''
sb = sb + (min(bass_att, 2.5) - sb) * 0.05;
sm = sm + (min(mid_att, 2.5) - sm) * 0.03;
st = st + (min(treb_att, 2.5) - st) * 0.1;
bt = max(bt * 0.94, beat);
be = be + (bt - be) * 0.12;
// The wander over the glass (accumulated, wrapped), quicker with the bass.
pw = pw + 0.006 + 0.014 * min(sb, 2) / 2;
pw = pw - 125.66371 * floor(pw / 125.66371);
// The waves running along the filaments.
p1 = p1 + 0.05 + 0.06 * min(sb, 2) / 2;
p1 = p1 - 6.2831853 * floor(p1 / 6.2831853);
p2 = p2 + 0.08 + 0.05 * min(sm, 2) / 2;
p2 = p2 - 6.2831853 * floor(p2 / 6.2831853);
p3 = p3 + 0.2 + 0.25 * min(st, 2) / 2;
p3 = p3 - 6.2831853 * floor(p3 / 6.2831853);
// A fingertip on a kick, at most every two seconds.
tt = tt + 1 / 60;
if(be > 0.5 && tt > 2,
  ta = ta + 1.2 + rand(1000) / 1000 * 3.9;
  ta = ta - 6.2831853 * floor(ta / 6.2831853);
  te = -0.35 + rand(1000) / 1000 * 0.7;
  tt = 0,
  0);
// Its strength: eased in over a quarter second, out over two.
tg = if(tt < 0.25, tt / 0.25, max(0, 1 - (tt - 0.25) / 2));
tw = tw + (tg * tg * (3 - 2 * tg) - tw) * 0.15;
hu = hu + 0.0002;
hu = hu - floor(hu);
q1 = sb; q2 = sm; q3 = st; q4 = be;
q5 = pw; q6 = p1; q7 = p2; q8 = p3;
q9 = ta; q10 = te; q11 = tw; q12 = hu;
'''

[shader]
comp = '''
let tau = 6.2831853;
let asp = u.texsize.x * u.texsize.w;
let sb = min(u.q[0].x, 2.0) * 0.5;
let sm = min(u.q[0].y, 2.0) * 0.5;
let st = max(0.0, min(u.q[0].z, 2.5) - 0.3);
let be = min(u.q[0].w, 1.0);
let pw = u.q[1].x;
let p1 = u.q[1].y;
let p2 = u.q[1].z;
let p3 = u.q[1].w;
let ta = u.q[2].x;
let te = u.q[2].y;
let tw = u.q[2].z;
let hu = u.q[2].w;
let p = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y);
let c = vec2f(0.0, 0.03);
let q = p - c;
let rq = length(q);
let rg = 0.44;
let re = 0.05;
// The fingertip's direction on the sphere.
let tv = vec3f(cos(te) * cos(ta), sin(te), cos(te) * sin(ta));
var fil = vec3f(0.0);
var spots = vec3f(0.0);
let wd = 0.004 * (1.0 + 0.5 * sb);
for (var k = 0; k < 8; k++) {
    let fk = f32(k);
    // The filament's end on the sphere, wandering in 3D.
    let az = fk * tau / 8.0 + pw * 0.5 + 0.9 * sin(pw * 0.35 + fk * 1.7) + 0.5 * sin(pw * 0.25 + fk * 2.9);
    let el = 0.75 * sin(pw * 0.3 + fk * 2.3) + 0.2 * sin(pw * 0.7 + fk);
    var v = vec3f(cos(el) * cos(az), sin(el), cos(el) * sin(az));
    // The fingertip draws the nearest ones to it.
    let pull = tw * smoothstep(0.0, 0.8, dot(v, tv)) * 0.7;
    v = normalize(mix(v, tv, pull));
    let e2 = v.xy * rg;
    let len = max(length(e2), 0.02);
    let dn = e2 / len;
    let pn = vec2f(-dn.y, dn.x);
    // Behind the electrode: dimmer, and hidden by it.
    let back = smoothstep(0.1, -0.4, v.z);
    let vis = mix(1.0, 0.35, back);
    let amp = (0.025 + 0.03 * sm) * (0.4 + 0.6 * len / rg);
    for (var b = 0; b < 3; b++) {
        // b = 0: the trunk; 1, 2: branches forking part of the way out.
        var o = vec2f(0.0);
        var dir = dn;
        var ln = len;
        var a0 = amp;
        var wsc = 1.0;
        var seed = fk * 3.7;
        if (b > 0) {
            let sf = select(0.38, 0.6, b == 2);
            let sgn = select(1.0, -1.0, b == 2);
            let s0 = sf;
            let off0 = amp * sin(3.14159 * s0) * (sin(s0 * 5.0 + p1 + seed) * 0.6 + sin(s0 * 11.0 - p2 * 1.3 + seed * 2.0) * 0.3
                + (0.03 + 0.1 * st) * sin(s0 * 29.0 + p3 + seed * 3.0));
            o = dn * (re + s0 * (len - re)) + pn * off0;
            let ang = sgn * (0.5 + 0.25 * sin(pw * 0.8 + fk));
            dir = vec2f(cos(ang) * dn.x - sin(ang) * dn.y, sin(ang) * dn.x + cos(ang) * dn.y);
            ln = (len - re) * (1.0 - sf) * (0.3 + 0.45 * sm);
            a0 = amp * 0.6;
            wsc = 0.7;
            seed = seed + f32(b) * 11.3;
        } else {
            o = dn * re;
            ln = len - re;
        }
        let rel = q - o;
        let al = dot(rel, dir);
        let s = clamp(al / max(ln, 1e-4), 0.0, 1.0);
        let pd = vec2f(-dir.y, dir.x);
        let env = select(sin(3.14159 * s), s * 1.2, b > 0);
        let off = a0 * env * (sin(s * 5.0 + p1 + seed) * 0.6 + sin(s * 11.0 - p2 * 1.3 + seed * 2.0) * 0.3
            + (0.03 + 0.1 * st) * sin(s * 29.0 + p3 + seed * 3.0));
        let dv = rel - dir * (s * ln) - pd * off;
        let d = length(dv);
        // Thinner toward the glass and along the branches.
        let w = wd * wsc * (1.0 - 0.45 * s);
        let core = exp(-d * d / (w * w));
        let glow = 0.015 / (d + 0.015) * exp(-d / 0.07);
        let tint = mix(vec3f(0.95, 0.3, 1.0), vec3f(0.35, 0.35, 1.0), s * 0.8);
        let fade = select(1.0, 1.0 - s * 0.7, b > 0);
        fil += (vec3f(1.0, 0.82, 1.0) * core * 1.3 + tint * glow * (0.9 + 0.6 * sb)) * vis * fade;
    }
    // Where it touches the glass.
    let ds = length(q - e2);
    let flare = 1.0 + 1.5 * pull;
    spots += mix(vec3f(1.0, 0.5, 0.95), vec3f(0.5, 0.45, 1.0), back) * (exp(-ds * ds / 0.00012) * 0.9 + 0.004 / (ds + 0.01)) * vis * flare;
}
let hs = 0.5 + 0.5 * cos(tau * (hu + vec3f(0.0, 0.33, 0.67)));
fil = fil * mix(vec3f(1.0), 0.6 + 0.8 * hs, 0.25);
let inside = smoothstep(rg + 0.004, rg - 0.004, rq);
// The room: dark, with a faint violet light from the globe.
var col = vec3f(0.006, 0.004, 0.014) + vec3f(0.12, 0.04, 0.2) * exp(-rq * 3.0) * (0.5 + 0.3 * sb);
// Light spilling from the glass into the room.
col += vec3f(0.16, 0.05, 0.28) * exp(-max(rq - rg, 0.0) / 0.1) * (1.0 - inside) * (0.5 + 0.3 * sb + 0.3 * tw);
// The glass: a faint haze inside, a fresnel rim and a window's highlight.
col += vec3f(0.11, 0.04, 0.19) * inside * (0.6 + 0.6 * smoothstep(0.0, rg, rq)) * (0.85 + 0.3 * sb);
col += vec3f(0.35, 0.45, 0.9) * exp(-abs(rq - rg) / 0.004) * 0.35;
let hl = q - vec2f(-0.17, 0.2);
col += vec3f(0.8, 0.85, 1.0) * exp(-dot(hl * vec2f(1.0, 1.8), hl * vec2f(1.0, 1.8)) / 0.002) * 0.12 * inside;
col += (fil + spots * 0.8) * inside;
// The electrode, hot and bright.
let ec = exp(-rq * rq / (re * re)) * (1.4 + 0.8 * sb + 0.4 * be);
col += mix(vec3f(0.9, 0.4, 1.0), vec3f(1.0, 0.9, 1.0), smoothstep(0.3, 1.2, ec)) * ec;
// The stand under the globe.
let sy = p.y - (c.y - rg);
let sw = 0.12 + 0.06 * smoothstep(0.0, -0.12, sy);
let stand = smoothstep(0.002, -0.002, sy + 0.005) * smoothstep(sw + 0.003, sw - 0.003, abs(p.x));
col = mix(col, vec3f(0.01, 0.008, 0.016) + vec3f(0.2, 0.08, 0.3) * exp(sy * 25.0) * 0.4, stand);
let lc = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lc) + (col - vec3f(lc)) * 1.2, vec3f(0.0));
return col / (1.0 + 0.3 * col);
'''
