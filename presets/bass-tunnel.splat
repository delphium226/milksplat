# Bass Tunnel: a ring of amber hexagons spins at the far end of a tunnel;
# the kick drives you forward through it. Pure equations, no shaders.
version = 1

[meta]
name = "Bass Tunnel"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.92
zoom = 1.03
warp = 0.15
wave_mode = 0
wave_a = 0.0
mesh = [48, 36]

[code]
frame = '''
q1 = 0.02 + 0.05 * min(bass_att, 2);
q2 = 0.006 + 0.01 * min(mid, 1.5);
q3 = time;
'''
vertex = '''
// Faster toward the rim, so the tunnel walls stream past.
zoom = 1 + q1 * (0.3 + rad * 1.2);
rot = q2 * (1 - rad);
'''

[[shape]]
enabled = true
sides = 6
instances = 8
rad = 0.035
r = 1.0
g = 0.4
b = 0.05
a = 0.55
r2 = 0.8
g2 = 0.08
b2 = 0.02
a2 = 0.15
border_r = 1.0
border_g = 0.55
border_b = 0.15
border_a = 0.4
additive = 1
frame = '''
a0 = instance / 8 * 6.2832 + q3 * (0.4 + 0.2 * min(mid, 1));
ring = 0.12 + 0.05 * min(bass, 2);
x = 0.5 + ring * cos(a0) * aspecty;
y = 0.5 + ring * sin(a0);
ang = -a0;
rad = 0.025 + 0.02 * min(bass, 2);
g = 0.3 + 0.25 * min(treb, 1);
'''

[[shape]]
enabled = true
sides = 32
rad = 0.06
r = 0.3
g = 0.05
b = 0.0
a = 0.5
r2 = 0.0
g2 = 0.0
b2 = 0.0
a2 = 0.0
additive = 1
frame = '''
rad = 0.04 + 0.03 * min(bass, 2);
r = 0.4 + 0.3 * min(treb, 1);
'''
