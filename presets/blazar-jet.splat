# Blazar Jet: a supermassive black hole fires a relativistic jet almost
# straight at you. The jet bursts out of the hole's throat and flares
# open toward the camera, a white-hot spine wrapped in a sheath of
# magenta and cyan synchrotron light, wound by the twin helices of its
# magnetic field. Bright knots of plasma race up it and swell as they come
# at you (apparently faster than light, as real blazar knots seem to be).
# Far below, the accretion disc swirls round the black shadow, white-blue
# at its inner edge and fading through gold to ember red, its approaching
# side brighter, a thin photon ring hugging the hole.
#
# Everything is in the composite. Each ray is clipped to the cylinder
# round the jet and marched through it, adding the light of the spine,
# the helical sheath (two strands wound round the cone, streaming outward)
# and the knots (Gaussian blobs at heights set by the frame code). Behind
# the jet the ray meets the disc's plane, whose turbulence turns with a
# Keplerian shear (inner rings faster), or the hole's shadow. A soft
# scattered glow hugs the jet's axis; stars sit behind it all.
#
# The phases are accumulated. Mids wind the helix and turn its colours.
# Each hit of the music is felt at once, through pulses of the bass, mids
# and treble that rise in a tick or two and die away over a fraction of a
# second (soft-limited, so a bigger hit still means more): a fresh kick
# fires a new knot up the jet (in the next of eight slots, brightening as
# it leaves the core, so its light ramps in), flares the jet's base and
# the inner disc, pushes the camera in and throws the helix and the disc
# on; the mids brighten the sheath; the treble sparkles along the strands
# and the stars.
version = 1

[meta]
name = "Blazar Jet"
author = "Milksplat"
license = "MIT OR Apache-2.0"

[params]
decay = 0.0
zoom = 1.0
warp = 0.0
wave_a = 0.0
mesh = [8, 6]

[code]
init = '''
hp = 0; fl = 0; dr = 0; hu = 0; sl = 0; cd = 0; at = 200;
z1 = 99; z2 = 99; z3 = 99; z4 = 99; z5 = 99; z6 = 99; z7 = 99; z8 = 99;
'''
frame = '''
// A slow, soft-limited level of the bass (the jet's steady power).
xs = max(bass_att - 1, 0); xs = xs / (1 + 0.5 * xs);
sb = sb + (xs - sb) * 0.05;
xs = max(mid_att - 1, 0); xs = xs / (1 + 0.5 * xs);
sm = sm + (xs - sm) * 0.05;
// The per-hit pulses: fast attack, slower decay, soft-limited.
ob = pb;
xb = max(bass - 1, 0); xb = xb / (1 + 0.5 * xb);
pb = pb + (xb - pb) * if(xb > pb, 0.6, 0.1);
xm = max(mid - 1, 0); xm = xm / (1 + 0.5 * xm);
pm = pm + (xm - pm) * if(xm > pm, 0.6, 0.1);
xt = max(treb - 1, 0); xt = xt / (1 + 0.5 * xt);
pt = pt + (xt - pt) * if(xt > pt, 0.6, 0.1);
// The helix winds and streams outward; each kick throws it on.
hp = hp + (0.5 + 0.6 * sm) / 60 + 0.08 * pb;
hp = hp - 6.2831853 * floor(hp / 6.2831853);
fl = fl + 0.6 / 60 + 0.12 * pb;
fl = fl - 6.2831853 * floor(fl / 6.2831853);
// The disc turns (its shear is in the shader), kicked on a little.
dr = dr + 0.25 / 60 + 0.03 * pb;
dr = dr - 50 * floor(dr / 50);
hu = hu + (0.004 + 0.06 * pm) / 60;
hu = hu - floor(hu);
// A fresh kick fires a knot up the jet, in the next of eight slots (and
// now and then one goes on its own, so the jet is never empty).
kk = pb - ob;
cd = cd + 1; at = at + 1;
if((kk > 0.08 && cd > 10) || at > 300,
  cd = 0; at = 0; sl = (sl + 1) % 8; na = 0.45 + min(pb, 1.4);
  if(sl == 0, z1 = 0.3; a1 = na, 0);
  if(sl == 1, z2 = 0.3; a2 = na, 0);
  if(sl == 2, z3 = 0.3; a3 = na, 0);
  if(sl == 3, z4 = 0.3; a4 = na, 0);
  if(sl == 4, z5 = 0.3; a5 = na, 0);
  if(sl == 5, z6 = 0.3; a6 = na, 0);
  if(sl == 6, z7 = 0.3; a7 = na, 0);
  if(sl == 7, z8 = 0.3; a8 = na, 0),
  0);
// The knots accelerate up the jet and are gone past z = 34.
z1 = min(z1 + 0.1 + 0.012 * z1, 99); z2 = min(z2 + 0.1 + 0.012 * z2, 99);
z3 = min(z3 + 0.1 + 0.012 * z3, 99); z4 = min(z4 + 0.1 + 0.012 * z4, 99);
z5 = min(z5 + 0.1 + 0.012 * z5, 99); z6 = min(z6 + 0.1 + 0.012 * z6, 99);
z7 = min(z7 + 0.1 + 0.012 * z7, 99); z8 = min(z8 + 0.1 + 0.012 * z8, 99);
q1 = hp; q2 = fl; q3 = dr; q4 = pb;
q5 = pm; q6 = pt; q7 = sb; q8 = hu;
q9 = z1; q10 = z2; q11 = z3; q12 = z4;
q13 = z5; q14 = z6; q15 = z7; q16 = z8;
q17 = a1; q18 = a2; q19 = a3; q20 = a4;
q21 = a5; q22 = a6; q23 = a7; q24 = a8;
'''

[shader]
comp = '''
let sz = u.texsize.xy;
let asp = sz.x / sz.y;
let hp = u.q[0].x;
let fl = u.q[0].y;
let dr = u.q[0].z;
let pb = u.q[0].w;
let pm = u.q[1].x;
let pt = u.q[1].y;
let sb = u.q[1].z;
let hu = u.q[1].w;
let lw = max(1.0, sz.y / 540.0);
let sp = vec2f((uv.x - 0.5) * asp, 0.5 - uv.y);
// The camera: 26 degrees off the jet's axis, pushed in on each kick.
let cd = 26.0 - 2.5 * pb;
let ca = 0.34;
let cb = 0.8 + 0.15 * sin(u.time * 0.05);
let cam = cd * vec3f(sin(ca) * cos(cb), sin(ca) * sin(cb), cos(ca));
let tgt = vec3f(0.0, 0.0, 7.5);
let fw = normalize(tgt - cam);
let rt = normalize(cross(fw, vec3f(0.0, 0.0, 1.0)));
let up = cross(rt, fw);
let rd = normalize(fw * 1.5 + rt * sp.x + up * sp.y);
// The sky: deep violet with faint stars.
var col = vec3f(0.012, 0.008, 0.03) + vec3f(0.03, 0.01, 0.05) * (1.0 - uv.y);
for (var l = 0; l < 2; l++) {
    let fl2 = f32(l);
    let ls = 70.0 + 50.0 * fl2;
    let q = sp * ls + vec2f(fl2 * 13.7, fl2 * 5.3);
    let c = floor(q);
    let h = fract(sin(vec2f(dot(c, vec2f(127.1, 311.7)), dot(c, vec2f(269.5, 183.3)))) * 43758.5453);
    let d = length(q - c - vec2f(0.2) - h * 0.6) / ls * sz.y / lw;
    let on = step(0.955, h.x);
    let tw = 0.7 + 0.3 * sin(u.time * (1.5 + 3.0 * h.y) + 30.0 * h.x) + 0.8 * pt;
    col += mix(vec3f(0.6, 0.75, 1.0), vec3f(1.0, 0.8, 0.6), h.y) * on * exp(-d * d / 0.9) * 0.6 * tw;
}
// The black hole's shadow: where the ray passes within 1 of the hole.
let tc = -dot(cam, rd);
let bmin = length(cam + rd * tc);
let shadow = bmin < 1.0;
// The disc's plane, z = 0.
if (rd.z < 0.0) {
    let t = -cam.z / rd.z;
    let P = cam + rd * t;
    let r = length(P.xy);
    if (r > 1.25 && r < 11.0 && !shadow) {
        let a = atan2(P.y, P.x);
        // Keplerian shear: the inner rings turn faster.
        // Two layers, each sheared over a cycle of 5 radians and faded
        // out as it restarts, so the spiral never winds up too tight.
        let kep = pow(r / 1.25, -1.5);
        let lr = log(r);
        var tex = 0.0;
        for (var m = 0; m < 2; m++) {
            let cyc = fract(dr / 5.0 + 0.5 * f32(m));
            let wt = 1.0 - abs(2.0 * cyc - 1.0);
            let w = (cyc * 5.0) * kep + dr * 0.12566371 + 1.7 * f32(m);
            let tu1 = sin(5.0 * (a - w) + 7.0 * lr);
            let tu2 = sin(11.0 * (a - w) - 13.0 * lr + 1.3);
            let tu3 = sin(23.0 * (a - w) + 29.0 * lr + 2.1);
            tex += wt * (0.55 + 0.25 * tu1 + 0.13 * tu2 + 0.07 * tu3);
        }
        // Temperature falls with radius; the approaching side is brighter.
        let x = clamp((r - 1.25) / 9.75, 0.0, 1.0);
        let hot = mix(vec3f(0.75, 0.85, 1.0), vec3f(1.0, 0.75, 0.3), smoothstep(0.0, 0.25, x));
        let tcol = mix(hot, vec3f(0.9, 0.18, 0.06), smoothstep(0.2, 0.8, x));
        let dop = 1.0 + 0.55 * sin(a - cb + 0.4);
        let edge = smoothstep(1.25, 1.6, r) * (1.0 - smoothstep(6.0, 11.0, r));
        let inner = exp(-(r - 1.3) * 1.2) * (1.0 + 0.8 * pb);
        col += tcol * tex * edge * dop * (0.55 + 1.6 * inner + 0.25 * sb);
    }
}
if (shadow) {
    col *= 0.05;
}
// The photon ring.
let pr = (bmin - 1.02) * 30.0;
col += vec3f(1.0, 0.85, 0.65) * exp(-pr * pr) * select(0.0, 1.0, tc > 0.0) * (0.7 + 0.8 * pb);
// The jet: clip the ray to the cylinder r < 8, 0.4 < z < 40.
let rj0 = 0.25;
let rjk = 0.21;
let aa = dot(rd.xy, rd.xy);
let bb = dot(cam.xy, rd.xy);
let cc = dot(cam.xy, cam.xy) - 64.0;
let disc = bb * bb - aa * cc;
var jet = vec3f(0.0);
// The sheath's colours, swung by the mids.
let h1 = 6.2831853 * (hu + 0.85);
let shc = mix(vec3f(1.0, 0.2, 0.75), vec3f(0.6, 0.3, 1.0), 0.5 + 0.5 * cos(h1));
let h2 = 6.2831853 * (hu + 0.5);
let shc2 = mix(vec3f(0.15, 0.85, 1.0), vec3f(0.3, 0.5, 1.0), 0.5 + 0.5 * cos(h2));
if (disc > 0.0) {
    let sq = sqrt(disc);
    var t0 = (-bb - sq) / aa;
    var t1 = (-bb + sq) / aa;
    // The slab 0.4 < z < 40.
    let za = (0.4 - cam.z) / rd.z;
    let zb = (40.0 - cam.z) / rd.z;
    t0 = max(max(t0, min(za, zb)), 0.0);
    t1 = min(t1, max(za, zb));
    if (t1 > t0) {
        let ns = 40;
        let dt = (t1 - t0) / f32(ns);
        let jit = fract(sin(dot(uv * sz, vec2f(12.9898, 78.233))) * 43758.5453);
        var t = t0 + dt * jit;
        for (var i = 0; i < ns; i++) {
            let P = cam + rd * t;
            let z = P.z;
            let r = length(P.xy);
            let rj = rj0 + rjk * z;
            let rr = r / rj;
            if (rr < 1.6) {
                let a = atan2(P.y, P.x);
                let fz = exp(-z * 0.06);
                // The spine, flared at the base on each kick.
                let spine = exp(-rr * rr * 14.0) * (1.0 + 0.4 * sb + 2.5 * pb * exp(-z * 0.4));
                // The knots: blobs on the axis, ramping in as they leave
                // the core and fading out far up.
                var kn = 0.0;
                for (var k = 0; k < 8; k++) {
                    let kz = u.q[2 + k / 4][k % 4];
                    let ka = u.q[4 + k / 4][k % 4];
                    let wz = 0.5 + 0.06 * kz;
                    let dz = (z - kz) / wz;
                    kn += ka * exp(-dz * dz) * smoothstep(0.3, 3.5, kz) * (1.0 - smoothstep(18.0, 34.0, kz));
                }
                let knot = kn * exp(-rr * rr * 3.0);
                let shell = exp(-(rr - 0.75) * (rr - 0.75) * 12.0);
                let e = vec3f(0.75, 0.88, 1.0) * spine * 1.5
                    + mix(shc2, shc, 0.5 + 0.5 * sin(a + z * 0.2)) * shell * (0.1 + 0.1 * pm)
                    + mix(vec3f(0.4, 0.85, 1.0), vec3f(1.0, 0.9, 1.0), exp(-rr * rr * 10.0)) * knot * 1.2;
                jet += e * fz * dt;
            }
            t += dt;
        }
    }
}
col += jet * 0.55;
// The magnetic helices: two strands wound on the cone r = 0.75 rj(z),
// drawn where the ray crosses it (front and back), streaming outward.
let c0 = 0.75 * rj0;
let c1 = 0.75 * rjk;
let ka2 = rd.x * rd.x + rd.y * rd.y - c1 * c1 * rd.z * rd.z;
let cz = c0 + c1 * cam.z;
let kb2 = 2.0 * (cam.x * rd.x + cam.y * rd.y - c1 * rd.z * cz);
let kc2 = cam.x * cam.x + cam.y * cam.y - cz * cz;
let kd2 = kb2 * kb2 - 4.0 * ka2 * kc2;
if (kd2 > 0.0) {
    let sq2 = sqrt(kd2);
    for (var j = 0; j < 2; j++) {
        let t = (-kb2 + select(-sq2, sq2, j == 1)) / (2.0 * ka2);
        let P = cam + rd * t;
        if (t > 0.0 && P.z > 0.4 && P.z < 40.0) {
            let a = atan2(P.y, P.x);
            let z = P.z;
            let fz = exp(-z * 0.035) * smoothstep(0.4, 1.5, z);
            let hel = 3.0 * a - 0.4 * z + hp * 3.0 - fl * 3.0;
            let ch = cos(hel);
            // The line, a few pixels wide however near it comes.
            let wl = 10.0 + 2.0 * z;
            let line = exp((ch - 1.0) * wl);
            let halo = exp((ch - 1.0) * 3.0);
            let fil = 0.5 + 0.5 * sin(5.0 * a + 1.3 * z - fl * 5.0);
            let glint = 1.0 + 2.0 * pt * step(0.6, sin(7.0 * z - fl * 9.0 + 3.0 * a));
            let side = select(0.55, 1.0, j == 0);
            let hc = mix(shc, shc2, 0.5 + 0.5 * sin(hel * 0.5 + z * 0.15));
            col += hc * (line * 1.1 * glint + halo * 0.18 + fil * 0.06) * fz * side * (0.7 + 0.7 * pm + 0.3 * sb + 0.4 * pb);
        }
    }
}
// A soft scattered glow round the jet's axis (the closest approach of
// the ray to the axis, for z above 0).
let cxy = cam.xy;
let dxy = rd.xy;
let ta = max(-dot(cxy, dxy) / max(dot(dxy, dxy), 1e-6), 0.0);
let za2 = cam.z + rd.z * ta;
let dax = length(cxy + dxy * ta);
let gax = exp(-dax * 0.9) * smoothstep(-1.0, 2.0, za2) * exp(-max(za2, 0.0) * 0.03);
col += mix(shc, vec3f(0.5, 0.6, 1.0), 0.5) * gax * (0.25 + 0.2 * sb + 0.3 * pb);
let lm = dot(col, vec3f(0.3, 0.5, 0.2));
col = max(vec3f(lm) + (col - vec3f(lm)) * 1.2, vec3f(0.0));
return col / (1.0 + 0.45 * col);
'''
